 /* a6xx_flush + fenced write: publish the ring, write WPTR, retry while the GMU fence drops it. */
+/*
+ * NX741J: the ring is 32 KiB (8192 dwords) and a submission writes about 40 dwords, so
+ * writing without looking at the read pointer lets the writer overtake commands the CP has
+ * not consumed yet. Once that happens the CP stalls and every later fence times out for good
+ * (vktest: PASS for ~550 s, then vkWaitForFences -> VK_TIMEOUT forever). Wait for space first.
+ */
+static void
+ring_wait_space(uint32_t need)
+{
+	const uint32_t total = (uint32_t)(gpu_bufs[0].bytes / 4);
+	if (!total) {
+		return;
+	}
+	for (unsigned spin = 0; spin < 2000; spin++) {
+		const uint32_t rptr = gr(CP_RB_RPTR) % total;
+		const uint32_t used = (ring_wptr + total - rptr) % total;
+		if (used + need + 8 < total) {
+			return;
+		}
+		delay(1);
+	}
+	printf("PANDORA GPU: ring full (wptr %u rptr %u need %u); submitting anyway\n",
+	    ring_wptr, gr(CP_RB_RPTR), need);
+}
