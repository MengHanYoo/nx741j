 static struct gpu_bo gpu_bos[GPU_MAX_BOS];
 
+/*
+ * NX741J (0236): the guide's map rule (NativeAdrenoVm::preflight, exclusivePages). A mapping may
+ * share physical pages with another mapping of its own cache/shareability/privilege class, never
+ * with one of another class. Driver memory owns the pool until its unmap completes, so its map is
+ * the bare table write with no alias pass; an import's pages (an IOSurface) any process may map
+ * again, so an import is checked only while a mapping of the other class is live. Every GPU
+ * mapping here is normal non-cacheable, outer shareable and unprivileged, so the class is the
+ * write permission alone.
+ */
+static unsigned
+gpu_alias_class(uint32_t perm, bool readonly)
+{
+	return ((perm & 2) && !readonly) ? 1u : 0u;
+}
+static uint64_t gpu_map_pages_cls[2];       /* live mapped 4K pages, per alias class */
+static uint64_t gpu_import_pages_cls[2];    /* the imported ones, per alias class */
+static uint64_t gpu_alias_maps, gpu_alias_skips, gpu_alias_checks, gpu_alias_refused;
+
+/* Does [pa, pa + bytes) touch a page of B: its pool run, or an import's own pages? */
+static bool
+gpu_bo_touches(const struct gpu_bo *b, uint64_t pa, uint64_t bytes)
+{
+	if (!bytes || !b->bytes) {
+		return false;
+	}
+	if (!b->pages) {
+		uint64_t at = gpu_pool_pa + b->off;
+		return at < pa + bytes && pa < at + b->bytes;
+	}
+	for (uint64_t i = 0; i < (b->bytes >> 12); i++) {
+		uint64_t at = b->pages[i];
+		if (at < pa + bytes && pa < at + 0x1000) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* The alias pass for an import of CLASS: no live mapping of another class may share a page with
+ * it, and no page may lie in the BO pool (driver memory is never an import). */
+static bool
+gpu_alias_pass(const struct gpu_bo *b, unsigned cls)
+{
+	if (gpu_pool_bytes && gpu_bo_touches(b, gpu_pool_pa, gpu_pool_bytes)) {
+		printf("PANDORA GPU: import of client %d covers BO pool pages\n", b->client);
+		return false;
+	}
+	for (unsigned i = 0; i < GPU_MAX_BOS; i++) {
+		const struct gpu_bo *o = &gpu_bos[i];
+		bool hit;
+		if (!o->used || !o->iova || gpu_alias_class(o->perm, o->readonly) == cls) {
+			continue;
+		}
+		hit = o->pages ? false : gpu_bo_touches(b, gpu_pool_pa + o->off, o->bytes);
+		for (uint64_t p = 0; !hit && o->pages && p < (o->bytes >> 12); p++) {
+			hit = gpu_bo_touches(b, o->pages[p], 0x1000);
+		}
+		if (hit) {
+			printf("PANDORA GPU: import of client %d aliases client %d mapping %#llx\n", b->client,
+			    o->client, o->iova);
+			return false;
+		}
+	}
+	return true;
+}
