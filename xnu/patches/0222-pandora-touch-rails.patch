+/*
+ * PANDORA/NX741J: print the regulator names the cmd-db holds (the key is the name's first
+ * eight bytes), so a board's rails can be named in the boot-args instead of being guessed.
+ * pandora_cmddb_dump=1
+ */
+static void
+rh_dump_names(void)
+{
+	unsigned lines = 0;
+	for (unsigned i = 0; i < 8 && lines < 200; i++) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		unsigned count = rh_db16(h + 6);
+		if ((entries & 3u) || entries + count * RH_DB_ENTRY > PT_CMDDB_SIZE) {
+			continue;
+		}
+		for (unsigned j = 0; j < count && lines < 200; j++) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			uint32_t kk[2] = {pt_rd(rh_db, e), pt_rd(rh_db, e + 4)};
+			char nm[9];
+			for (unsigned b = 0; b < 8; b++) {
+				nm[b] = (char)((kk[b / 4] >> (8u * (b % 4))) & 0xffu);
+			}
+			nm[8] = 0;
+			/* regulators are L/S/V..., the rest (clocks, buses) start elsewhere */
+			if (nm[0] != 'L' && nm[0] != 'S' && nm[0] != 'V' && nm[0] != 'B') {
+				continue;
+			}
+			printf("PANDORA TOUCH: cmddb %s addr=%#x slave=%u\n", nm, pt_rd(rh_db, e + 16), slave);
+			lines++;
+		}
+	}
+	printf("PANDORA TOUCH: cmddb dump end (%u lines)\n", lines);
+}
+
+/*
+ * PANDORA/NX741J: one or two rails, named in the boot-args:
+ *   pandora_touch_rail1=NAME:mV   (default L4I_E0:1800, the Xiaomi 17 Pro iovdd)
+ *   pandora_touch_rail2=NAME:mV   (default off)
+ * The Z80 Ultra's touch needs pmh0101_l4 (1.8 V, vdd) and pmh0101_l14 (3.2 V, avdd).
+ */
+static int
+pt_rpmh_rails(void)
+{
+	char arg[64];
+	int last = 0;
+	for (unsigned i = 0; i < 2; i++) {
+		char name[16];
+		unsigned n = 0;
+		uint32_t mv = 0;
+		const char *key = i ? "pandora_touch_rail2" : "pandora_touch_rail1";
+		if (!PE_parse_boot_argn(key, arg, sizeof(arg))) {
+			if (i != 0) {
+				continue;
+			}
+			const char *d = "L4I_E0";
+			while (d[n] && n < sizeof(name) - 1) {
+				name[n] = d[n];
+				n++;
+			}
+			name[n] = 0;
+			mv = 1800;
+		} else {
+			const char *p = arg;
+			while (*p && *p != ':' && n < sizeof(name) - 1) {
+				name[n++] = *p++;
+			}
+			name[n] = 0;
+			if (*p == ':') {
+				p++;
+				while (*p >= '0' && *p <= '9') {
+					mv = mv * 10u + (uint32_t)(*p++ - '0');
+				}
+			}
+			if (n == 0 || mv == 0) {
+				printf("PANDORA TOUCH: %s=%s malformed (NAME:mV)\n", key, arg);
+				continue;
+			}
+		}
+		int err = pt_rpmh_vote(name, mv);
+		printf("PANDORA TOUCH: rail %s %u mV -> %d\n", name, mv, err);
+		last = err;
+	}
+	return last;
 }
 
