diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_ufs.c
@@ -0,0 +1,735 @@
+/*
+ * SWEET internal UFS root device (read-only).
+ *
+ * The Qualcomm UFS host (UFSHCI 2.1) is left enabled with the link up by the
+ * bootloader, which loaded our boot image from it. This driver reuses that
+ * state: it points the transfer request list at its own memory (verifying the
+ * host took it before ringing any doorbell) and issues polled SCSI commands,
+ * one at a time, to LUN 0. It finds one GPT partition by name (boot-arg
+ * ufsroot=, default "userdata") and exposes it as the BSD disk ufsroot0
+ * (rufsroot0), with 512-byte logical sectors over the device's 4 KiB blocks.
+ * Root on it with rd=ufsroot0.
+ *
+ * All DMA goes through one physically contiguous allocation (descriptors and
+ * a 1 MiB bounce buffer); the host is not cache coherent, so caches are
+ * cleaned/invalidated around each command. Writes are refused.
+ */
+#if 1 /* NX741J: ported from pandora (SM8850) */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define REG_CAP         0x00
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define PU_REG_UICCMD   0x90
+#define PU_HCS_UCRDY    (1u << 3)
+#define PU_IS_UCCS      (1u << 10)
+#define PU_IS_UHXS      (1u << 5)
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+
+#define UFS_BLOCK       4096u
+#define BOUNCE_SIZE (64 * 1024)   /* NX741J: 1 MiB contiguous allocation hung in the IOKit context */
+#define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
+#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
+#define CMD_TIMEOUT_NS  (2ull * 1000 * 1000 * 1000)   /* NX741J: shorter, feedback over speed */
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, DWORDs */
+	uint32_t prdt;          /* [31:16] PRDT offset (DWORDs), [15:0] entries */
+};
+
+struct ucd {
+	uint8_t cmd[512];
+	uint8_t resp[512];
+	struct {
+		uint32_t addr_lo, addr_hi, rsvd, dbc;
+	} prdt[PRDT_MAX];
+};
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UCD         0x1000                  /* 128 byte aligned */
+#define DMA_BOUNCE      0x4000
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint8_t lun;
+	uint8_t tag;
+	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} su;
+
+static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
+static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.regs + off);
+}
+
+static inline void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	/* third argument TRUE: the address is physical (arm/caches_internal.c) */
+	flush_dcache64((addr64_t)(su.dma + off), len, FALSE);
+}
+
+/*
+ * One SCSI command in slot 0, data (if any) to/from the bounce buffer.
+ * Read direction only. Returns 0 or an errno.
+ */
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
+
+	assert(len <= BOUNCE_SIZE);
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
+	ucd->cmd[1] = len ? 0x40 : 0x00;        /* R: data in */
+	ucd->cmd[2] = su.lun;
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[12] = (uint8_t)(len >> 24);
+	ucd->cmd[13] = (uint8_t)(len >> 16);
+	ucd->cmd[14] = (uint8_t)(len >> 8);
+	ucd->cmd[15] = (uint8_t)len;
+	memcpy(&ucd->cmd[16], cdb, cdb_len);
+
+	utrd->dw0 = (1u << 28) | ((len ? 2u : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	if (len) {
+		uint32_t n = 0;
+		for (uint32_t done = 0; done < len; done += PRDT_CHUNK, n++) {
+			uint32_t chunk = MIN(PRDT_CHUNK, len - done);
+			ucd->prdt[n].addr_lo = (uint32_t)(bounce_pa + done);
+			ucd->prdt[n].addr_hi = (uint32_t)((bounce_pa + done) >> 32);
+			ucd->prdt[n].dbc = chunk - 1;
+		}
+		utrd->prdt = (1024u / 4) << 16 | n;
+	}
+
+	printf("SWEET UFS: building cmd 0x%02x lun 0x%x len %u\n", cdb[0], su.lun, len);
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	if (len) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+	__builtin_arm_dsb(0xf);
+	printf("SWEET UFS: synced, ringing hcs=%08x dbr=%08x\n", ufs_rd(REG_HCS), ufs_rd(REG_UTRLDBR));
+
+	ufs_wr(REG_UTRLDBR, 1);
+	printf("SWEET UFS: ringed cmd 0x%02x dbr=%08x is=%08x\n", cdb[0], ufs_rd(REG_UTRLDBR), ufs_rd(REG_IS));
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("SWEET UFS: command 0x%02x timed out\n", cdb[0]);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	if (len) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
+		printf("SWEET UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		return EIO;
+	}
+	return 0;
+}
+
+/* READ(10) of count device blocks at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK);
+}
+
+static int
+ufs_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(1, 1);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("SWEET UFS: LUN %u has no GPT\n", su.lun);
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("SWEET UFS: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first) {
+			return ENXIO;
+		}
+		su.first_block = first;
+		su.nblocks = last - first + 1;
+		return 0;
+	}
+	printf("SWEET UFS: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+static int
+ufs_take_over_host(void)
+{
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		printf("SWEET UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
+		return ENXIO;
+	}
+	if (ufs_rd(REG_UTRLDBR)) {
+		printf("SWEET UFS: requests outstanding from the bootloader\n");
+		return EBUSY;
+	}
+	ufs_wr(REG_IE, 0);                      /* polled operation */
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		printf("SWEET UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+sweet_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+sweet_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+
+	buf_setresid(bp, count);
+	if (!(buf_flags(bp) & B_READ)) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = ufs_read_blocks(su.first_block + lba, blocks);
+		if (error) {
+			break;
+		}
+		memcpy(vaddr + done, (const void *)(su.dma + DMA_BOUNCE + skip), want);
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = su.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		su.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = UFS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = su.nblocks * UFS_BLOCK / su.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / su.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_ufs_psize(__unused dev_t dev)
+{
+	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_ufs_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)su.secsize);
+}
+
+static int
+sweet_ufs_write(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return EROFS;
+}
+
+static const struct bdevsw sweet_ufs_bdevsw = {
+	.d_open     = sweet_ufs_open,
+	.d_close    = sweet_ufs_close,
+	.d_strategy = sweet_ufs_strategy,
+	.d_ioctl    = sweet_ufs_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_ufs_cdevsw = {
+	.d_open       = sweet_ufs_open,
+	.d_close      = sweet_ufs_close,
+	.d_read       = sweet_ufs_read,
+	.d_write      = sweet_ufs_write,
+	.d_ioctl      = sweet_ufs_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+sweet_ufs_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	static const char *const paths[] = { "/soc/ufshc@1d84000", "/sweet-ufs", "/arm-io/ufshc" };
+	int ok = 0;
+	for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+		if (SecureDTLookupEntry(NULL, paths[i], &node) == kSuccess &&
+		    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) == kSuccess &&
+		    size >= 2 * sizeof(uintptr_t)) {
+			printf("SWEET UFS: node %s\n", paths[i]);
+			ok = 1;
+			break;
+		}
+	}
+	if (!ok) {
+		printf("SWEET UFS: no UFS node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+
+	su.regs = ml_io_map(reg[0], reg[1]);
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_take_over_host();
+	if (!error) {
+		static const uint8_t tur[6] = { 0x00 };
+		/* The first command after the bootloader may report a unit attention. */
+		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0)); i++) {
+		}
+	}
+	if (!error) {
+		error = ufs_find_partition(want);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+	su.ready = true;
+	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, read-only\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20);
+	return 0;
+}
+
+/* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+int sweet_ufs_rootdev(dev_t *dev);
+
+int
+sweet_ufs_rootdev(dev_t *dev)
+{
+	if (!su.ready) {
+		int error = sweet_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = su.bdev;
+	return 0;
+}
+
+uint64_t native_ufs_first_block = 0;
+uint64_t native_ufs_blocks = 0;
+
+/*
+ * Probe entry called from the board's ShengUfs component when
+ * native-ufs-probe=20: bring-up, TUR and GPT lookup, then report.  Kept
+ * non-static so the link never drops it (SYSINIT was dead-stripped).
+ */
+/*
+ * The bootloader hands the link over in HIBERN8 with auto-hibernate off, so a
+ * request never leaves the host.  Wake it the way Linux does: DME_HIBERNATE_EXIT,
+ * wait for IS.UCCS, then for IS.UHXS, and require HCS.UPMCRS = PWR_LOCAL.
+ * (Ported from pandora's 0118-pandora-ufs-hibern8-exit.patch.)
+ */
+static int
+pandora_h8_exit(void)
+{
+	if (!(ufs_rd(REG_HCS) & PU_HCS_UCRDY)) {
+		return EBUSY;
+	}
+	ufs_wr(REG_IS, PU_IS_UCCS | PU_IS_UHXS);
+	ufs_wr(PU_REG_UICCMD + 4, 0);
+	ufs_wr(PU_REG_UICCMD + 8, 0);
+	ufs_wr(PU_REG_UICCMD + 12, 0);
+	ufs_wr(PU_REG_UICCMD, 0x18);
+	for (int i = 0; i < 100000 && !(ufs_rd(REG_IS) & PU_IS_UCCS); i++) {
+		delay(1);
+	}
+	if (!(ufs_rd(REG_IS) & PU_IS_UCCS)) {
+		return ETIMEDOUT;
+	}
+	uint32_t rc = ufs_rd(PU_REG_UICCMD + 8) & 0xff;
+	ufs_wr(REG_IS, PU_IS_UCCS);
+	if (rc) {
+		return (int)(0x100 | rc);
+	}
+	for (int i = 0; i < 500000 && !(ufs_rd(REG_IS) & PU_IS_UHXS); i++) {
+		delay(1);
+	}
+	if (!(ufs_rd(REG_IS) & PU_IS_UHXS)) {
+		return (int)(0x300 | ETIMEDOUT);
+	}
+	ufs_wr(REG_IS, PU_IS_UHXS);
+	uint32_t upmcrs = (ufs_rd(REG_HCS) >> 8) & 7;
+	return upmcrs == 1 ? 0 : (int)(0x200 | upmcrs);
+}
+
+int
+native_ufs_probe(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	static const char *const paths[] = { "/soc/ufshc@1d84000", "/sweet-ufs", "/arm-io/ufshc" };
+	int ok = 0;
+	printf("NX741J UFS: probe start\n");
+	for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+		if (SecureDTLookupEntry(NULL, paths[i], &node) == kSuccess &&
+		    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) == kSuccess &&
+		    size >= 2 * sizeof(uintptr_t)) {
+			ok = 1;
+			printf("NX741J UFS: node %s\n", paths[i]);
+			break;
+		}
+	}
+	if (!ok) {
+		printf("NX741J UFS: no device tree node\n");
+		return ENXIO;
+	}
+	printf("NX741J UFS: reg0=%lx reg1=%lx size=%x\n", (unsigned long)reg[0], (unsigned long)reg[1], size);
+	uint64_t base = (uint64_t)reg[0];
+	uint64_t len = (uint64_t)reg[1];
+	if (base < 0x1000000ULL) {
+		printf("NX741J UFS: base 0x%llx looks truncated, using 0x1d84000\n", (unsigned long long)base);
+		base = 0x1d84000ULL;
+	}
+	if (len == 0 || len > 0x10000ULL) {
+		len = 0x3000ULL;
+	}
+	su.regs = ml_io_map((vm_offset_t)base, (vm_size_t)len);
+	if (!su.regs) {
+		printf("NX741J UFS: ml_io_map failed\n");
+		return ENXIO;
+	}
+	printf("NX741J UFS: hc=%lx cap=%08x hcs=%08x hce=%08x\n", (unsigned long)su.regs,
+	       ufs_rd(REG_CAP), ufs_rd(REG_HCS), ufs_rd(REG_HCE));
+	printf("NX741J UFS: memcfg=%08x mcqcfg=%08x mcqcap=%08x ufstrlbase=%08x\n",
+	       ufs_rd(0x300), ufs_rd(0x380), ufs_rd(0x1a0), ufs_rd(REG_UTRLBA));
+	printf("NX741J UFS: allocating %u bytes of contiguous DMA\n", (unsigned)DMA_SIZE);
+	kern_return_t kr = kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT);
+	printf("NX741J UFS: kmem_alloc_contig kr=%d va=%lx\n", kr, (unsigned long)su.dma);
+	if (kr != KERN_SUCCESS) {
+		printf("NX741J UFS: no contiguous DMA\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		printf("NX741J UFS: no physical page\n");
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	printf("NX741J UFS: dma pa=%llx\n", (unsigned long long)su.dma_pa);
+	{
+		uintptr_t smmu = ml_io_map(0x15000000ULL, 0xd0000);
+		if (smmu) {
+			uint32_t scr0 = *(volatile uint32_t *)(smmu + 0x00);
+			uint32_t smr = *(volatile uint32_t *)(smmu + 0x800 + 4 * 0x60);
+			uint32_t s2cr = *(volatile uint32_t *)(smmu + 0xc00 + 4 * 0x60);
+			uint32_t cbar = *(volatile uint32_t *)(smmu + 0x1000);
+			uint32_t sctlr = *(volatile uint32_t *)(smmu + 0x1000 + 0x0);
+			printf("NX741J UFS: smmu scr0=%08x smr60=%08x s2cr60=%08x cbar=%08x sctlr=%08x\n",
+			       scr0, smr, s2cr, cbar, sctlr);
+			if ((scr0 & 1u) && (s2cr & 0xffu) != 1u) {
+				*(volatile uint32_t *)(smmu + 0xc00 + 4 * 0x60) = 1u;
+				__builtin_arm_dsb(0xf);
+				printf("NX741J UFS: stream 0x60 forced to bypass, now %08x\n",
+				       *(volatile uint32_t *)(smmu + 0xc00 + 4 * 0x60));
+			}
+		} else {
+			printf("NX741J UFS: smmu map failed\n");
+		}
+	}
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+	lck_mtx_lock(&sweet_ufs_lock);
+	int e = ufs_take_over_host();
+	printf("NX741J UFS: takeover rc=%d utrlba=%08x rsr=%08x dbr=%08x\n", e,
+	       ufs_rd(REG_UTRLBA), ufs_rd(REG_UTRLRSR), ufs_rd(REG_UTRLDBR));
+	if (!e) {
+		/* NX741J: our firmware already woke the link (it read the payload from
+		 * UFS); DME_HIBERNATE_EXIT came back 0x101 and left IS.UE set, after
+		 * which the doorbell store hangs.  Skip it and clear the status. */
+		printf("NX741J UFS: skipping hibernate exit, hcs=%08x is=%08x\n", ufs_rd(REG_HCS), ufs_rd(REG_IS));
+		ufs_wr(REG_IS, ufs_rd(REG_IS));
+		{
+			/* GCC UFS PHY block at 0x177000: AXI 0x18, AHB 0x24, UNIPRO 0x68, GDSCR 0x04 */
+			uintptr_t gcc = ml_io_map(0x177000ULL, 0x1000);
+			if (gcc) {
+				uint32_t gdsc = *(volatile uint32_t *)(gcc + 0x04);
+				uint32_t axi = *(volatile uint32_t *)(gcc + 0x18);
+				uint32_t ahb = *(volatile uint32_t *)(gcc + 0x24);
+				uint32_t uni = *(volatile uint32_t *)(gcc + 0x68);
+				printf("NX741J UFS: gcc gdsc=%08x axi=%08x ahb=%08x unipro=%08x\n", gdsc, axi, ahb, uni);
+				*(volatile uint32_t *)(gcc + 0x18) = axi | 1u;
+				*(volatile uint32_t *)(gcc + 0x24) = ahb | 1u;
+				*(volatile uint32_t *)(gcc + 0x68) = uni | 1u;
+				__builtin_arm_dsb(0xf);
+			} else {
+				printf("NX741J UFS: gcc map failed\n");
+			}
+		}
+	}
+	if (!e) {
+		static const uint8_t active[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+		su.lun = 0xd0;
+		for (int i = 0; i < 3 && (e = ufs_scsi(active, sizeof(active), 0)); i++) {
+			printf("NX741J UFS: SSU try %d rc=%d\n", i + 1, e);
+		}
+		su.lun = 0;
+		printf("NX741J UFS: SSU ACTIVE rc=%d dbr=%08x is=%08x\n", e, ufs_rd(REG_UTRLDBR), ufs_rd(REG_IS));
+	}
+	if (!e) {
+		static const uint8_t tur[6] = { 0x00 };
+		for (int i = 0; i < 3 && (e = ufs_scsi(tur, sizeof(tur), 0)); i++) {
+		}
+		printf("NX741J UFS: tur rc=%d dbr=%08x is=%08x\n", e, ufs_rd(REG_UTRLDBR), ufs_rd(REG_IS));
+	}
+	if (!e) {
+		e = ufs_find_partition("userdata");
+		native_ufs_first_block = su.first_block;
+		native_ufs_blocks = su.nblocks;
+		printf("NX741J UFS: gpt rc=%d first=%llx blocks=%llu\n", e,
+		       (unsigned long long)su.first_block, (unsigned long long)su.nblocks);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	printf("NX741J UFS: probe done rc=%d\n", e);
+	return e;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
