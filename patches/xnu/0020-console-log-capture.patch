diff --git a/osfmk/kern/printf.c b/osfmk/kern/printf.c
index e44008f..c055b00 100644
--- a/osfmk/kern/printf.c
+++ b/osfmk/kern/printf.c
@@ -908,9 +908,29 @@ vprintf(const char *fmt, va_list ap)
 	return vprintf_internal(fmt, ap, __builtin_return_address(0));
 }
 
+/*
+ * UniXNU,NX741J: in-memory console capture.  The panel font is too small to read
+ * a full boot log and this board has no UART, so every console byte is also kept
+ * in a static buffer that starts with a magic.  The efisp loader scans DRAM for
+ * the magic on the next boot and copies the buffer to the rawdump area, where the
+ * host reads it back over 9008.
+ */
+volatile unsigned char nxl_console_log[0x20000] __attribute__((aligned(4096))) = {
+	'N', 'X', 'L', 'O', 'G', '1', 0, 0,
+};
+static unsigned int nxl_console_len;
+
 void
 consdebug_putc(char c)
 {
+	if (nxl_console_len < sizeof(nxl_console_log) - 12) {
+		nxl_console_log[12 + nxl_console_len] = (unsigned char)c;
+		nxl_console_len++;
+		nxl_console_log[8] = (unsigned char)(nxl_console_len);
+		nxl_console_log[9] = (unsigned char)(nxl_console_len >> 8);
+		nxl_console_log[10] = (unsigned char)(nxl_console_len >> 16);
+		nxl_console_log[11] = (unsigned char)(nxl_console_len >> 24);
+	}
 	if (!disableConsoleOutput) {
 		console_write_char(c);
 	}
