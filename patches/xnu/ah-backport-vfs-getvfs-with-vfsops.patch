@@ -1945,6 +1945,22 @@
 	return mount_list_lookupby_fsid(fsid, 0, 0);
 }
 
+/*
+ * Lookup a mount point by filesystem identifier and verify its vfsops.
+ * The original kernelcache exports this entry point and the retained kexts
+ * (apfs among them) import it; the 8796 source drop omits it.
+ */
+struct mount *
+vfs_getvfs_with_vfsops(fsid_t *fsid, const struct vfsops * const ops)
+{
+	mount_t mp = mount_list_lookupby_fsid(fsid, 0, 0);
+
+	if (mp != NULL && mp->mnt_op != ops) {
+		mp = NULL;
+	}
+	return mp;
+}
