diff --git a/bsd/dev/native_ufs_iova.c b/bsd/dev/native_ufs_iova.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/native_ufs_iova.c
@@ -0,0 +1,736 @@
+/*
+ * NX741J: bring the UFS host up through apps_smmu, the way this board's own
+ * device tree says it must be done.
+ *
+ *   ufshc@1d84000 { iommus = <&apps_smmu 0x60 0x0>;
+ *                   memory-region = <&ufshc_dma_resv_region>; }
+ *   ufshc_dma_resv_region { iommu-addresses = <&ufshc 0x0 0x0 0x0 0x1000>; }
+ *
+ * The request list therefore lives at IOVA 0x0 and every descriptor address is
+ * an IOVA, translated by stream 0x60.  Programming UTRLBA with a physical
+ * address while the SMMU is off makes the host fetch from an address nobody
+ * owns, which is the "every register works, any slot store stalls" symptom
+ * recorded in docs/STATUS-2026-11-15/17.
+ *
+ * Layout of the 80 KiB contiguous block allocated here:
+ *
+ *   0x0000  UTRL (request list, 1 KiB)         -> IOVA 0x0000
+ *   0x1000  UCD  (command descriptor)          -> IOVA 0x1000
+ *   0x4000  bounce buffer                      -> IOVA 0x4000
+ *   0x10000 L1 table (4 KiB)
+ *   0x11000 L2 table
+ *   0x12000 L3 table
+ *
+ * The mapping is the identity of that block in IOVA space: IOVA i -> PA+ i for
+ * 0 <= i < 0x14000.  Nothing else is mapped, so a stray access faults with a
+ * visible FSR instead of vanishing.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <mach/mach_time.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+#define UFS_HC          0x1d84000ULL
+#define UFS_HC_SIZE     0x3000ULL
+#define SMMU_BASE       0x15000000ULL
+#define SMMU_SIZE       0x100000ULL
+
+#define REG_IS          0x20
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+#define HCS_UCRDY       (1u << 2)
+
+#define SMMU_SCR0       0x00
+#define SMMU_IDR0       0x20
+#define SMMU_IDR1       0x24
+#define SMMU_GR0_SMR    0x800
+#define SMMU_GR0_S2CR   0xc00
+#define SMMU_CB_SCTLR   0x00
+#define SMMU_CB_TCR2    0x10
+#define SMMU_CB_TTBR0   0x20
+#define SMMU_CB_TCR     0x30
+#define SMMU_CB_MAIR0   0x38
+#define SMMU_CB_MAIR1   0x3c
+#define SMMU_CB_FSR     0x58
+
+#define UFS_STREAM      0x60
+
+#define DMA_BYTES       0x14000ULL      /* 80 KiB, same size the working probe used */
+#define TBL_L1          0x10000ULL
+#define TBL_L2          0x11000ULL
+#define TBL_L3          0x12000ULL
+
+static uint32_t rd32 (uintptr_t base, unsigned off)
+{
+  return *(volatile uint32_t *)(base + off);
+}
+
+static void wr32 (uintptr_t base, unsigned off, uint32_t value)
+{
+  *(volatile uint32_t *)(base + off) = value;
+  __builtin_arm_dsb (0xf);
+}
+
+int
+native_ufs_probe_iova (void)
+{
+  {
+    unsigned qemu = 0;
+    if (PE_parse_boot_argn ("qemu-mark", &qemu, sizeof (qemu)) && qemu == 1) {
+      printf ("NX741J UFS iova: skipped under QEMU\n");
+      return 0;
+    }
+  }
+
+  printf ("NX741J iova: stage 1 (maps)\n");
+  uintptr_t hc = ml_io_map (UFS_HC, UFS_HC_SIZE);
+  uintptr_t smmu = ml_io_map (SMMU_BASE, 0x1000);
+  uintptr_t gr1 = 0, cb = 0;
+  vm_offset_t dma = 0;
+  kern_return_t kr;
+  ppnum_t pn;
+  uint64_t dma_pa;
+  volatile uint32_t *w;
+  unsigned i;
+  uint32_t idr1, stride, pages, banks, cb0, scr0, tcr;
+  uint64_t deadline;
+  uint32_t dbr, ocs, fsr;
+
+  if (!hc || !smmu) {
+    panic ("NX741J UFS iova: map failed hc=%p smmu=%p", (void *)hc, (void *)smmu);
+  }
+
+  /* Stage 1: contiguous block for the list, UCD, bounce and the three tables. */
+  printf ("NX741J iova: stage 2 (dma)\n");
+  kr = kmem_alloc_contig (kernel_map, &dma, DMA_BYTES, 0xfff, 0, 0,
+                          KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT);
+  if (kr != KERN_SUCCESS || !dma) {
+    panic ("NX741J UFS iova: dma alloc failed %d", kr);
+  }
+  pn = pmap_find_phys (kernel_pmap, (addr64_t)dma);
+  if (!pn) {
+    panic ("NX741J UFS iova: no physical page");
+  }
+  dma_pa = ptoa_64 (pn);
+  if (dma_pa & 0xfff) {
+    panic ("NX741J UFS iova: dma not 4K aligned %llx", (unsigned long long)dma_pa);
+  }
+
+  /* Stage 2: three-level native 4K tables for a 32-bit IOVA space.
+   *   4 KiB granule: L1 covers 1 GiB, L2 2 MiB, L3 4 KiB; T0SZ = 0.
+   *   Leaf: page(0x3) | AttrIndx 0 | AP RW(0xc0) | SH inner(0x300) | AF(0x400). */
+  w = (volatile uint32_t *)(dma + TBL_L1);
+  for (i = 0; i < 1024; i++) w[i] = 0;
+  w[0] = (uint32_t)((dma_pa + TBL_L2) & 0xfffff000ULL) | 0x3;
+
+  w = (volatile uint32_t *)(dma + TBL_L2);
+  for (i = 0; i < 1024; i++) w[i] = 0;
+  w[0] = (uint32_t)((dma_pa + TBL_L3) & 0xfffff000ULL) | 0x3;
+
+  w = (volatile uint32_t *)(dma + TBL_L3);
+  for (i = 0; i < 1024; i++) w[i] = 0;
+  for (i = 0; i < 0x14; i++) {                    /* 0x14000 / 0x1000 */
+    uint64_t pa = dma_pa + (uint64_t)i * 0x1000ULL;
+    w[i] = (uint32_t)(pa & 0xfffff000ULL) | 0x3 | (3u << 6) | (3u << 8) | (1u << 10);
+    if ((pa >> 32) != 0) {
+      panic ("NX741J UFS iova: pa above 4G %llx", (unsigned long long)pa);
+    }
+  }
+  flush_dcache64 ((addr64_t)((dma + TBL_L1)), 0x3000, 0);
+  __builtin_arm_dsb (0xf);
+
+  /* Stage 3: context bank 0 for stream 0x60, using the kit's register rules
+   * (kits/ArmSmmu4K): stride/pages come from IDR1, CB base = (pages + bank) * stride. */
+  printf ("NX741J iova: stage 4 (smmu idr)\n");
+  gr1 = ml_io_map (SMMU_BASE + 0x1000, 0x1000);
+  if (!gr1) {
+    panic ("NX741J UFS iova: gr1 map failed");
+  }
+  idr1 = rd32 (smmu, SMMU_IDR1);
+  stride = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+  pages = 1u << (((idr1 >> 28) & 7) + 1);
+  banks = idr1 & 0xffu;
+  if (banks == 0) {
+    panic ("NX741J UFS iova: no context banks idr1=%08x", idr1);
+  }
+  cb0 = rd32 (gr1, 0) & 0xffff0000u;   /* CBAR0: CB base, low bits are type/IRQ */
+  if (cb0 == 0) {
+    cb0 = 0x10000u;
+  }
+  printf ("NX741J iova: stage 5 (map gr1/cb) idr1=%08x stride=%x cb0=%x\n", idr1, stride, cb0);
+  cb = ml_io_map (SMMU_BASE + cb0, 0x1000);
+  if (!gr1 || !cb) {
+    panic ("NX741J UFS iova: page map failed gr1=%p cb=%p stride=%x cb0=%x",
+           (void *)gr1, (void *)cb, stride, cb0);
+  }
+  printf ("NX741J UFS iova: idr1=%08x stride=%x pages=%u cb0=%x\n", idr1, stride, pages, cb0);
+  if ((uint64_t)cb0 + 0x800ULL > SMMU_SIZE) {
+    panic ("NX741J UFS iova: cb out of window idr1=%08x stride=%x pages=%u cb0=%x",
+           idr1, stride, pages, cb0);
+  }
+
+  wr32 (cb, SMMU_CB_SCTLR, 0);            /* disabled while programming */
+  wr32 (cb, SMMU_CB_MAIR0, 0xff);         /* attr0: normal WB, outer+inner */
+  wr32 (cb, SMMU_CB_MAIR1, 0x00);
+  *(volatile uint64_t *)(cb + SMMU_CB_TTBR0) = (dma_pa + TBL_L1) & 0xfffffffffffcULL;
+  __builtin_arm_dsb (0xf);
+  tcr = (1u << 8) | (1u << 10) | (3u << 12);      /* IRGN0 WB, ORGN0 WB, SH0 inner, TG0 4K, T0SZ 0 */
+  wr32 (cb, SMMU_CB_TCR, tcr);
+  wr32 (cb, SMMU_CB_TCR2, 0);
+  wr32 (gr1, 0x800, 0);         /* CBA2R0 */
+  wr32 (gr1, 0, cb0);               /* CBAR0: stage 1 translation */
+  __builtin_arm_dsb (0xf);
+
+  printf ("NX741J iova: stage 6 (cb programmed) cb=%lx gr1=%lx\n", (unsigned long)cb, (unsigned long)gr1);
+  wr32 (cb, SMMU_CB_SCTLR, 1);            /* M = 1 */
+  if ((rd32 (cb, SMMU_CB_SCTLR) & 1) == 0) {
+    panic ("NX741J UFS iova: sctl r readback 0 (tcr=%08x idr1=%08x)", tcr, idr1);
+  }
+  wr32 (cb, 0x610, 0);                    /* TLBIASID 0 */
+  wr32 (cb, 0x7f0, 0xffffffffu);          /* TLBSYNC */
+  __builtin_arm_dsb (0xf);
+
+  /* Stream 0x60: SMR valid, ID 0x60, mask 0; S2CR -> CB0 stage 1 translation. */
+  wr32 (smmu, SMMU_GR0_SMR + 8 * UFS_STREAM, (1u << 31) | UFS_STREAM);
+  wr32 (smmu, SMMU_GR0_S2CR + 4 * UFS_STREAM, 0);
+  __builtin_arm_dsb (0xf);
+
+  printf ("NX741J iova: stage 7 (stream set)\n");
+  scr0 = rd32 (smmu, SMMU_SCR0);
+  wr32 (smmu, SMMU_SCR0, scr0 | 1u);
+  scr0 = rd32 (smmu, SMMU_SCR0);
+
+  /* Stage 4: the host takes IOVA addresses. List at 0, UCD at 0x1000. */
+  wr32 (hc, REG_HCE, rd32 (hc, REG_HCE) | 1u);
+  for (i = 0; i < 100000 && !(rd32 (hc, REG_HCS) & HCS_UCRDY); i++) {
+    delay (1);
+  }
+  if (!(rd32 (hc, REG_HCS) & (HCS_DP | HCS_UCRDY))) {
+    panic ("NX741J UFS iova: host not ready hcs=%08x scr0=%08x", rd32 (hc, REG_HCS), scr0);
+  }
+  wr32 (hc, REG_UTRLRSR, 0);
+  wr32 (hc, REG_UTRLCLR, 0xffffffffu);
+  wr32 (hc, REG_IS, rd32 (hc, REG_IS));
+  wr32 (hc, REG_UTRLBA, 0);
+  wr32 (hc, REG_UTRLBAU, 0);
+  wr32 (hc, REG_UTRLRSR, 1);
+  if (rd32 (hc, REG_UTRLBA) != 0 || (rd32 (hc, REG_UTRLRSR) & 1) == 0) {
+    panic ("NX741J UFS iova: list rejected utrlba=%08x rsr=%08x",
+           rd32 (hc, REG_UTRLBA), rd32 (hc, REG_UTRLRSR));
+  }
+
+  /* Stage 5: one TEST UNIT READY on LUN 0, polled. */
+  {
+    volatile uint32_t *l = (volatile uint32_t *)dma;             /* IOVA 0 */
+    volatile uint8_t *ucd = (volatile uint8_t *)(dma + 0x1000);  /* IOVA 0x1000 */
+    for (i = 0; i < 256; i++) ucd[i] = 0;
+    ucd[0] = 0x01;      /* COMMAND UPIU */
+    ucd[1] = 0x00;      /* no data */
+    ucd[2] = 0x00;      /* LUN 0 */
+    ucd[3] = 0x5a;      /* tag */
+    ucd[16] = 0x00;     /* TEST UNIT READY */
+    l[0] = (1u << 28) | (1u << 24);       /* I, no data-in */
+    l[1] = 0;
+    l[2] = 0x0f;
+    l[3] = 0;
+    l[4] = 0x1000;                        /* UCDBA: IOVA of the UCD */
+    l[5] = 0;
+    l[6] = (128u << 16) | 128u;           /* response UPIU, 128 dwords */
+    l[7] = (256u << 16) | 0u;             /* PRDT offset 256 dwords, 0 entries */
+    flush_dcache64 ((addr64_t)(dma), 0x2000, 0);
+    __builtin_arm_dsb (0xf);
+
+    printf ("NX741J iova: stage 8 (ring)\n");
+  wr32 (hc, REG_UTRLDBR, 1);
+    nanoseconds_to_absolutetime (2ull * 1000 * 1000 * 1000, &deadline);
+    deadline += mach_absolute_time ();
+    while ((rd32 (hc, REG_UTRLDBR) & 1) && mach_absolute_time () < deadline) {
+      delay (1);
+    }
+  }
+
+  dbr = rd32 (hc, REG_UTRLDBR);
+  ocs = ((volatile uint32_t *)dma)[2] & 0x3f;
+  fsr = rd32 (cb, SMMU_CB_FSR);
+
+  panic ("NX741J UFS iova\n"
+         "dma=%llx iova0 pa\n"
+         "scr0=%08x smr=%08x s2cr=%08x\n"
+         "tcr=%08x cb0=%08x\n"
+         "dbr=%08x ocs=%02x fsr=%08x\n"
+         "hcs=%08x is=%08x",
+         (unsigned long long)dma_pa,
+         scr0,
+         rd32 (smmu, SMMU_GR0_SMR + 8 * UFS_STREAM),
+         rd32 (smmu, SMMU_GR0_S2CR + 4 * UFS_STREAM),
+         tcr, cb0, dbr, ocs, fsr,
+         rd32 (hc, REG_HCS), rd32 (hc, REG_IS));
+  return 0;
+}
+
+/*
+ * Read-only layout dump (native-ufs-probe=31).
+ *
+ * Before programming anything, read the register blocks this SoC actually
+ * implements: the IDs and control word of the SMMU, the two candidate GR1
+ * windows and the two candidate context-bank windows, plus the UFS host.  The
+ * ArmSmmu4K kit assumes IDR0 at 0x20 / SCR0 at 0x00 / GR1 = stride; this dump
+ * tells whether a qcom,qsmmu-v500 agrees.
+ */
+int
+native_ufs_probe_dump (void)
+{
+  static const struct { uint64_t phys; const char *name; } win[] = {
+    { 0x15000000ULL, "smmu+0000" },
+    { 0x15001000ULL, "smmu+1000" },
+    { 0x15008000ULL, "smmu+8000" },
+    { 0x15010000ULL, "smmu+10000" },
+    { 0x15080000ULL, "smmu+80000" },
+    { 0x1d84000ULL,  "ufshc" },
+  };
+  unsigned qemu = 0;
+  unsigned w;
+
+  if (PE_parse_boot_argn ("qemu-mark", &qemu, sizeof (qemu)) && qemu == 1) {
+    return 0;
+  }
+
+  for (w = 0; w < sizeof (win) / sizeof (win[0]); w++) {
+    uintptr_t m = ml_io_map (win[w].phys, 0x1000);
+    unsigned i;
+    if (!m) {
+      printf ("NX741J dump %s phys=%llx: map failed\n",
+              win[w].name, (unsigned long long)win[w].phys);
+      continue;
+    }
+    printf ("NX741J dump %s phys=%llx:", win[w].name, (unsigned long long)win[w].phys);
+    for (i = 0; i < 16; i++) {
+      printf (" %08x", *(volatile uint32_t *)(m + i * 4));
+    }
+    printf ("\n");
+  }
+  panic ("NX741J dump done");
+  return 0;
+}
+
+/* Read-only: is the context-bank page reachable at all? (native-ufs-probe=32) */
+int
+native_ufs_probe_cb (void)
+{
+  unsigned qemu = 0;
+  uintptr_t m;
+  unsigned i;
+
+  if (PE_parse_boot_argn ("qemu-mark", &qemu, sizeof (qemu)) && qemu == 1) {
+    return 0;
+  }
+  printf ("NX741J cb: reading 0x15010000\n");
+  m = ml_io_map (0x15010000ULL, 0x1000);
+  if (!m) {
+    panic ("NX741J cb: map failed");
+  }
+  printf ("NX741J cb 15010000 va=%lx:", (unsigned long)m);
+  for (i = 0; i < 16; i++) {
+    printf (" %08x", *(volatile uint32_t *)(m + i * 4));
+  }
+  printf ("\n");
+  printf ("NX741J cb: SCTLR=%08x TTBR0=%08x%08x TCR=%08x\n",
+          *(volatile uint32_t *)(m + 0x00),
+          *(volatile uint32_t *)(m + 0x24),
+          *(volatile uint32_t *)(m + 0x20),
+          *(volatile uint32_t *)(m + 0x30));
+  panic ("NX741J cb done");
+  return 0;
+}
+
+/*
+ * native-ufs-probe=33: the data-a-live configuration.
+ *
+ * Their working unit has stream 0x60 matched to CB0 with SCTLR.M = 0, i.e. the
+ * stream passes through untranslated, so the host is programmed with physical
+ * addresses.  This board left stream 0x60 in translation instead; a physical
+ * UTRLBA is then looked up as an IOVA, misses, and the interconnect stalls.
+ * Force the bypass here and ring with a physical list.  The context-bank page
+ * is never touched (it aborts on this unit).
+ */
+int
+native_ufs_probe_bypass (void)
+{
+  uintptr_t hc;
+  uintptr_t smmu;
+  vm_offset_t dma = 0;
+  kern_return_t kr;
+  ppnum_t pn;
+  uint64_t dma_pa;
+  uint32_t smr_before, s2cr_before, smr_after, s2cr_after;
+  uint32_t dbr, ocs, hcs, is;
+  uint64_t deadline;
+  unsigned i;
+  volatile uint32_t *l;
+  volatile uint8_t *ucd;
+
+  if (PE_parse_boot_argn ("qemu-mark", &i, sizeof (i)) && i == 1) {
+    return 0;
+  }
+  hc = ml_io_map (UFS_HC, 0x1000);
+  smmu = ml_io_map (SMMU_BASE, 0x1000);
+  if (!hc || !smmu) {
+    panic ("NX741J bypass: map failed hc=%p smmu=%p", (void *)hc, (void *)smmu);
+  }
+  smr_before = rd32 (smmu, 0x800 + 4 * 0);
+  s2cr_before = rd32 (smmu, 0xc00 + 4 * 0);
+  printf ("NX741J bypass: before smr60=%08x s2cr60=%08x scr0=%08x\n",
+          smr_before, s2cr_before, rd32 (smmu, 0x00));
+
+  /* Stream 0x60: no match entry, bypass to the physical address space. */
+  wr32 (smmu, 0x800 + 4 * 0, 0x80000060u);   /* VALID | ID 0x60 | MASK 0 */
+  wr32 (smmu, 0xc00 + 4 * 0, 1);             /* bypass */
+  smr_after = rd32 (smmu, 0x800 + 4 * 0);
+  s2cr_after = rd32 (smmu, 0xc00 + 4 * 0);
+  printf ("NX741J bypass: after smr60=%08x s2cr60=%08x\n", smr_after, s2cr_after);
+
+  kr = kmem_alloc_contig (kernel_map, &dma, 0x14000, 0xfff, 0, 0,
+                          KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT);
+  if (kr != KERN_SUCCESS || !dma) {
+    panic ("NX741J bypass: dma alloc %d", kr);
+  }
+  pn = pmap_find_phys (kernel_pmap, (addr64_t)dma);
+  if (!pn) {
+    panic ("NX741J bypass: no page");
+  }
+  dma_pa = ptoa_64 (pn);
+  printf ("NX741J bypass: dma pa=%llx\n", (unsigned long long)dma_pa);
+
+  wr32 (hc, REG_HCE, rd32 (hc, REG_HCE) | 1u);
+  for (i = 0; i < 100000 && !(rd32 (hc, REG_HCS) & 0x8); i++) {
+    delay (1);
+  }
+  wr32 (hc, REG_UTRLRSR, 0);
+  wr32 (hc, REG_UTRLCLR, 0xffffffffu);
+  wr32 (hc, REG_IS, rd32 (hc, REG_IS));
+  wr32 (hc, REG_UTRLBA, (uint32_t)dma_pa);
+  wr32 (hc, REG_UTRLBAU, (uint32_t)(dma_pa >> 32));
+  wr32 (hc, REG_UTRLRSR, 1);
+  printf ("NX741J bypass: list started rsr=%08x hcs=%08x utrlba=%08x\n",
+          rd32 (hc, REG_UTRLRSR), rd32 (hc, REG_HCS), rd32 (hc, REG_UTRLBA));
+  if (rd32 (hc, REG_UTRLBA) != (uint32_t)dma_pa) {
+    panic ("NX741J bypass: list rejected want=%llx got=%08x",
+           (unsigned long long)dma_pa, rd32 (hc, REG_UTRLBA));
+  }
+
+  l = (volatile uint32_t *)dma;
+  ucd = (volatile uint8_t *)(dma + 0x1000);
+  for (i = 0; i < 256; i++) ucd[i] = 0;
+  ucd[0] = 0x01; ucd[1] = 0x00; ucd[2] = 0x00; ucd[3] = 0x5a; ucd[16] = 0x00;
+  l[0] = (1u << 28) | (1u << 24);
+  l[1] = 0;
+  l[2] = 0x0f;
+  l[3] = 0;
+  l[4] = (uint32_t)(dma_pa + 0x1000);
+  l[5] = (uint32_t)((dma_pa + 0x1000) >> 32);
+  l[6] = (128u << 16) | 128u;
+  l[7] = (256u << 16) | 0u;
+  flush_dcache64 ((addr64_t)dma, 0x2000, 0);
+
+  wr32 (hc, 0x24, 0);                       /* IE = 0: polled only */
+  wr32 (hc, REG_IS, rd32 (hc, REG_IS));     /* acknowledge stale status */
+  printf ("NX741J bypass: ringing pa=%llx ucd=%llx ie=0 is=%08x\n",
+          (unsigned long long)dma_pa, (unsigned long long)(dma_pa + 0x1000),
+          rd32 (hc, REG_IS));
+  wr32 (hc, REG_UTRLDBR, 1);
+  printf ("NX741J bypass: ring returned dbr=%08x is=%08x gfrsr=%08x rsr=%08x hcs=%08x\n",
+          rd32 (hc, REG_UTRLDBR), rd32 (hc, REG_IS), rd32 (smmu, 0x48),
+          rd32 (hc, REG_UTRLRSR), rd32 (hc, REG_HCS));
+  nanoseconds_to_absolutetime (2ull * 1000 * 1000 * 1000, &deadline);
+  deadline += mach_absolute_time ();
+  while ((rd32 (hc, REG_UTRLDBR) & 1) && mach_absolute_time () < deadline) {
+    delay (1);
+  }
+  dbr = rd32 (hc, REG_UTRLDBR);
+  ocs = l[2] & 0x3f;
+  hcs = rd32 (hc, REG_HCS);
+  is = rd32 (hc, REG_IS);
+  panic ("NX741J bypass result\n"
+         "s2cr60 %08x -> %08x\n"
+         "smr60  %08x -> %08x\n"
+         "dbr=%08x ocs=%02x\n"
+         "hcs=%08x is=%08x\n"
+         "pa=%llx",
+         s2cr_before, s2cr_after, smr_before, smr_after,
+         dbr, ocs, hcs, is, (unsigned long long)dma_pa);
+  return 0;
+}
+
+/*
+ * native-ufs-probe=34: the data-a-live SMMU walk, read-only.
+ *
+ * Their driver derives the layout from IDR0/IDR1 (SMMU_SMR(n)=0x800+4n,
+ * SMMU_S2CR(n)=0xc00+4n, GR1 page from IDR1[31], banks after numpage*page) and
+ * finds the stream by matching SMR.ID, not by indexing SMR with the stream id.
+ * Print the first eight matches and their S2CR so we can see what the bootloader
+ * left for stream 0x60 on this unit.
+ */
+int
+native_ufs_probe_smmu_walk (void)
+{
+  uintptr_t gr0;
+  uint32_t idr0, idr1, nsmr, page, numpage;
+  unsigned i;
+  unsigned qemu = 0;
+
+  if (PE_parse_boot_argn ("qemu-mark", &qemu, sizeof (qemu)) && qemu == 1) {
+    return 0;
+  }
+  gr0 = ml_io_map (SMMU_BASE, 0x1000);
+  if (!gr0) {
+    panic ("NX741J walk: gr0 map failed");
+  }
+  idr0 = rd32 (gr0, 0x20);
+  idr1 = rd32 (gr0, 0x24);
+  nsmr = idr0 & 0xff;
+  page = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+  numpage = 1u << (((idr1 >> 28) & 7) + 1);
+
+  printf ("NX741J walk: idr0=%08x idr1=%08x nsmr=%u page=%x numpage=%u scr0=%08x\n",
+          idr0, idr1, nsmr, page, numpage, rd32 (gr0, 0x00));
+  printf ("NX741J walk: gfrsr=%08x\n", rd32 (gr0, 0x48));
+
+  for (i = 0; i < nsmr && i < 8; i++) {
+    uint32_t smr = rd32 (gr0, 0x800 + 4 * i);
+    uint32_t s2cr = rd32 (gr0, 0xc00 + 4 * i);
+    printf ("NX741J walk: smr[%u]=%08x (valid=%u id=%#x mask=%#x) s2cr=%08x\n",
+            i, smr, (smr >> 31) & 1, smr & 0x7fff, (smr >> 16) & 0x7fff, s2cr);
+  }
+
+  panic ("NX741J walk done");
+  return 0;
+}
+
+/*
+ * native-ufs-probe=35: put the request list where the bootloader had it.
+ *
+ * Our own DMA at 0xb4a0_xxxx never gets fetched (DBR stays set, no fault),
+ * while the bootloader read its list from 0xc3af_xxxx for the payload load.
+ * Write the same UTRD/UCD into that region through per-page device mappings,
+ * only with 4-byte accesses (64-bit struct stores faulted before), then ring.
+ */
+int
+native_ufs_probe_abl_list (void)
+{
+  uintptr_t hc, gr0;
+  uint32_t list_pa, ucd_pa;
+  volatile uint32_t *lp;
+  volatile uint8_t *up;
+  uint32_t dbr, ocs, hcs, is;
+  uint64_t deadline;
+  unsigned i;
+  unsigned qemu = 0;
+
+  if (PE_parse_boot_argn ("qemu-mark", &qemu, sizeof (qemu)) && qemu == 1) {
+    return 0;
+  }
+  hc = ml_io_map (UFS_HC, 0x1000);
+  gr0 = ml_io_map (SMMU_BASE, 0x1000);
+  if (!hc || !gr0) {
+    panic ("NX741J abl: map failed");
+  }
+  /* stream 0x60: match + bypass, as before */
+  wr32 (gr0, 0x800, 0x80000060u);
+  wr32 (gr0, 0xc00, 1u);
+  __builtin_arm_dsb (0xf);
+
+  list_pa = rd32 (hc, REG_UTRLBA) & 0xfffff000u;
+  ucd_pa = list_pa + 0x1000;
+  printf ("NX741J abl: list=%08x ucd=%08x\n", list_pa, ucd_pa);
+
+  lp = (volatile uint32_t *)ml_io_map (list_pa, 0x1000);
+  up = (volatile uint8_t *)ml_io_map (ucd_pa, 0x1000);
+  if (!lp || !up) {
+    panic ("NX741J abl: list map failed lp=%p up=%p", (void *)lp, (void *)up);
+  }
+  for (i = 0; i < 128; i++) up[i] = 0;
+  up[0] = 0x01; up[1] = 0x00; up[2] = 0x00; up[3] = 0x5a; up[16] = 0x00;
+
+  lp[0] = (1u << 28) | (1u << 24);
+  lp[1] = 0;
+  lp[2] = 0x0f;
+  lp[3] = 0;
+  lp[4] = ucd_pa;
+  lp[5] = 0;
+  lp[6] = (128u << 16) | 128u;
+  lp[7] = (256u << 16) | 0u;
+  __builtin_arm_dsb (0xf);
+
+  wr32 (hc, 0x24, 0);
+  wr32 (hc, REG_IS, rd32 (hc, REG_IS));
+  wr32 (hc, REG_UTRLBA, list_pa);
+  wr32 (hc, REG_UTRLRSR, 1);
+  printf ("NX741J abl: started rsr=%08x hcs=%08x dbr=%08x\n",
+          rd32 (hc, REG_UTRLRSR), rd32 (hc, REG_HCS), rd32 (hc, REG_UTRLDBR));
+  wr32 (hc, REG_UTRLDBR, 1);
+  printf ("NX741J abl: ringed dbr=%08x is=%08x\n", rd32 (hc, REG_UTRLDBR), rd32 (hc, REG_IS));
+  nanoseconds_to_absolutetime (3ull * 1000 * 1000 * 1000, &deadline);
+  deadline += mach_absolute_time ();
+  while ((rd32 (hc, REG_UTRLDBR) & 1) && mach_absolute_time () < deadline) {
+    delay (1);
+  }
+  dbr = rd32 (hc, REG_UTRLDBR);
+  ocs = lp[2] & 0x3f;
+  hcs = rd32 (hc, REG_HCS);
+  is = rd32 (hc, REG_IS);
+  panic ("NX741J abl result\n"
+         "list=%08x ucd=%08x\n"
+         "dbr=%08x ocs=%02x is=%08x hcs=%08x",
+         list_pa, ucd_pa, dbr, ocs, is, hcs);
+  return 0;
+}
+
+/*
+ * native-ufs-probe=36: UFSHCI 4.0 bring-up order.
+ *
+ *   bypass stream 0x60 -> HCE=0 -> HCE=1 -> wait HCS.UCRDY
+ *   -> DME_LINKSTARTUP (UIC 0x16) -> wait HCS.DP
+ *   -> UTRLBA/UCD -> UTRLRSR=1 -> ring -> poll
+ *
+ * The earlier HCE experiments lost the device because the link was never
+ * restarted afterwards; UFSHCI requires DME_LINKSTARTUP before any request.
+ */
+static uint32_t uic_cmd (uintptr_t hc, uint32_t cmd, uint32_t arg1, uint32_t arg3, int *ok)
+{
+  uint32_t i;
+  *(volatile uint32_t *)(hc + 0x94) = arg1;
+  *(volatile uint32_t *)(hc + 0x98) = 0;
+  *(volatile uint32_t *)(hc + 0x9c) = arg3;
+  *(volatile uint32_t *)(hc + 0x20) = *(volatile uint32_t *)(hc + 0x20);
+  *(volatile uint32_t *)(hc + 0x90) = cmd;
+  for (i = 0; i < 100000; i++) {
+    if (*(volatile uint32_t *)(hc + 0x20) & (1u << 10)) {
+      break;
+    }
+    delay (1);
+  }
+  if (ok) {
+    *ok = (*(volatile uint32_t *)(hc + 0x20) & (1u << 10)) ? 1 : 0;
+  }
+  {
+    uint32_t res = *(volatile uint32_t *)(hc + 0x98);
+    *(volatile uint32_t *)(hc + 0x20) = 1u << 10;
+    return res;
+  }
+}
+
+int
+native_ufs_probe_spec (void)
+{
+  uintptr_t hc, gr0;
+  vm_offset_t dma = 0;
+  kern_return_t kr;
+  ppnum_t pn;
+  uint64_t dma_pa;
+  volatile uint32_t *l;
+  volatile uint8_t *ucd;
+  uint32_t dbr, ocs, hcs, is, res;
+  uint64_t deadline;
+  unsigned i;
+  int ok = 0;
+  unsigned qemu = 0;
+
+  if (PE_parse_boot_argn ("qemu-mark", &qemu, sizeof (qemu)) && qemu == 1) {
+    return 0;
+  }
+  hc = ml_io_map (UFS_HC, 0x1000);
+  gr0 = ml_io_map (SMMU_BASE, 0x1000);
+  if (!hc || !gr0) {
+    panic ("NX741J spec: map failed");
+  }
+  wr32 (gr0, 0x800, 0x80000060u);
+  wr32 (gr0, 0xc00, 1u);
+  __builtin_arm_dsb (0xf);
+  printf ("NX741J spec: stream 0x60 smr=%08x s2cr=%08x\n", rd32 (gr0, 0x800), rd32 (gr0, 0xc00));
+
+  /* HCE cycle, then DME_LINKSTARTUP, exactly in spec order. */
+  printf ("NX741J spec: hce=%08x hcs=%08x\n", rd32 (hc, REG_HCE), rd32 (hc, REG_HCS));
+  wr32 (hc, REG_HCE, 0);
+  for (i = 0; i < 100000 && (rd32 (hc, REG_HCE) & 1); i++) {
+    delay (1);
+  }
+  wr32 (hc, REG_UTRLRSR, 0);
+  wr32 (hc, REG_UTRLCLR, 0xffffffffu);
+  wr32 (hc, REG_IS, 0xffffffffu);
+  wr32 (hc, REG_HCE, 1);
+  for (i = 0; i < 100000 && !(rd32 (hc, REG_HCS) & 0x8); i++) {
+    delay (1);
+  }
+  printf ("NX741J spec: after hce hce=%08x hcs=%08x\n", rd32 (hc, REG_HCE), rd32 (hc, REG_HCS));
+
+  res = uic_cmd (hc, 0x16, 0, 0, &ok);       /* DME_LINKSTARTUP */
+  for (i = 0; i < 100000 && !(rd32 (hc, REG_HCS) & 0x1); i++) {
+    delay (1);
+  }
+  printf ("NX741J spec: linkstartup done=%d res=%08x hcs=%08x\n", ok, res, rd32 (hc, REG_HCS));
+
+  res = uic_cmd (hc, 0x02, 0x15610000u, 1u, &ok);   /* PA_PWRMode = FAST */
+  printf ("NX741J spec: pwr fast done=%d res=%08x\n", ok, res);
+
+  kr = kmem_alloc_contig (kernel_map, &dma, 0x14000, 0xfff, 0, 0, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT);
+  if (kr != KERN_SUCCESS || !dma) {
+    panic ("NX741J spec: dma alloc %d", kr);
+  }
+  pn = pmap_find_phys (kernel_pmap, (addr64_t)dma);
+  dma_pa = ptoa_64 (pn);
+  wr32 (hc, REG_UTRLBA, (uint32_t)dma_pa);
+  wr32 (hc, REG_UTRLBAU, (uint32_t)(dma_pa >> 32));
+  wr32 (hc, REG_UTRLRSR, 1);
+  printf ("NX741J spec: list pa=%llx rsr=%08x hcs=%08x\n",
+          (unsigned long long)dma_pa, rd32 (hc, REG_UTRLRSR), rd32 (hc, REG_HCS));
+
+  l = (volatile uint32_t *)dma;
+  ucd = (volatile uint8_t *)(dma + 0x1000);
+  for (i = 0; i < 256; i++) ucd[i] = 0;
+  ucd[0] = 0x01; ucd[1] = 0x00; ucd[2] = 0x00; ucd[3] = 0x5a; ucd[16] = 0x00;
+  l[0] = (1u << 28) | (1u << 24);
+  l[1] = 0;
+  l[2] = 0x0f;
+  l[3] = 0;
+  l[4] = (uint32_t)(dma_pa + 0x1000);
+  l[5] = (uint32_t)((dma_pa + 0x1000) >> 32);
+  l[6] = (128u << 16) | 128u;
+  l[7] = (256u << 16) | 0u;
+  flush_dcache64 ((addr64_t)dma, 0x2000, 0);
+  wr32 (hc, 0x24, 0);
+  wr32 (hc, REG_IS, rd32 (hc, REG_IS));
+  wr32 (hc, REG_UTRLDBR, 1);
+  printf ("NX741J spec: ringed dbr=%08x is=%08x\n", rd32 (hc, REG_UTRLDBR), rd32 (hc, REG_IS));
+  nanoseconds_to_absolutetime (3ull * 1000 * 1000 * 1000, &deadline);
+  deadline += mach_absolute_time ();
+  while ((rd32 (hc, REG_UTRLDBR) & 1) && mach_absolute_time () < deadline) {
+    delay (1);
+  }
+  dbr = rd32 (hc, REG_UTRLDBR);
+  ocs = l[2] & 0x3f;
+  hcs = rd32 (hc, REG_HCS);
+  is = rd32 (hc, REG_IS);
+  panic ("NX741J spec result\n"
+         "dbr=%08x ocs=%02x is=%08x hcs=%08x\n"
+         "pa=%llx",
+         dbr, ocs, is, hcs, (unsigned long long)dma_pa);
+  return 0;
+}
