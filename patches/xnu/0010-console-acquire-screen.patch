diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index 04dda53..710d363 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -513,7 +513,16 @@ PE_create_console(void)
 	check_for_panic_log();
 
 	if (PE_state.video.v_display) {
-		PE_initialize_console(&PE_state.video, kPEGraphicsMode);
+		/*
+		 * UniXNU,NX741J: two switches keep the kernel console silent on this port.
+		 * kPEGraphicsMode never sets gc_acquired (vcputc then drops every char), and
+		 * disableConsoleOutput stays TRUE outside the serial/no-video branches, so
+		 * conslog_putc discards the line before it ever reaches the console.
+		 */
+		extern boolean_t disableConsoleOutput;
+
+		PE_initialize_console(&PE_state.video, kPEAcquireScreen);
+		disableConsoleOutput = FALSE;
 	} else {
 		PE_initialize_console(&PE_state.video, kPETextMode);
 	}
