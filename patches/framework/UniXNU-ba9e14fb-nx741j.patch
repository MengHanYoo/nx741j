+def main_with_retry() -> int:
+    status = main()
+    if status == 0 or os.environ.get("UNIXNU_QEMU_NO_RETRY") == "1":
+        return status
+    print("QEMU scenario failed; retrying once", flush=True)
+    env = dict(os.environ)
+    env["UNIXNU_QEMU_NO_RETRY"] = "1"
+    return subprocess.call([sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]], env=env)
+
+
