	hypervisor {
		#address-cells = <0x02>;
		#size-cells = <0x00>;
		compatible = "qcom,gunyah-hypervisor-1.0", "qcom,gunyah-hypervisor", "simple-bus";

		qcom,gunyah-vm {
			compatible = "qcom,gunyah-vm-id-1.0", "qcom,gunyah-vm-id";
			qcom,vmid = <0x03>;
			qcom,vendor = "Qualcomm";
		};

		qcom,resource-manager-rpc@ae24815a6c4f2965 {
			compatible = "gunyah-resource-manager", "qcom,resource-manager-1-0", "qcom,resource-manager";
			reg = <0xae24815a 0x6c4f2965 0xae24815a 0x6c4f2d1c>;
			interrupts = <0x00 0x3c1 0x01 0x00 0x3c2 0x01>;
			qcom,free-irq-start = <0x3c0>;
			qcom,is-full-duplex;
			qcom,tx-message-size = <0xf0>;
			qcom,rx-message-size = <0xf0>;
			qcom,tx-queue-depth = <0x08>;
			qcom,rx-queue-depth = <0x08>;
		};
	};
};

/* --- generated by scripts/mk-adt-dts.py: ADT normalisation --- */
/ {
    model = "Nubia Z80 Ultra (NX741J)";
    compatible = "nubia,nx741j", "qcom,alor", "qcom,sm8850";
    memory {
        device_type = "memory";
        reg = <0x8 0xc0000000 0x1 0x40000000>;
    };
    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };
    cpus {
        timebase-frequency = <19200000>;
        /delete-node/ cpu-map;
        /delete-node/ idle-states;
    };
};

&{/soc/interrupt-controller@17000000} { unixnu,adt-name = "intc"; };
&{/soc/timer} { unixnu,adt-name = "arm-timer"; };
&{/soc/ufshc@1d84000} { unixnu,adt-name = "ufshc"; };
