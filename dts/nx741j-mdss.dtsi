			qcom,phy-supply-entry@0 {
				qcom,supply-disable-load = <0x60>;
				qcom,supply-enable-load = <0x17ed0>;
				qcom,supply-max-voltage = <0xd6d80>;
				qcom,supply-min-voltage = <0xd6d80>;
				qcom,supply-name = "vdda-0p9";
				reg = <0x00>;
			};
		};
	};
	dsi_pll_codes: dsi_pll_codes {
		label = "dsi_pll_codes";
		reg = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
				0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		#size-cells = <0x00>;
		#address-cells = <0x01>;
	};
	dsi_panel_pwr_supply: dsi_panel_pwr_supply {
		#size-cells = <0x00>;
		#address-cells = <0x01>;
		qcom,panel-supply-entry@0 {
			qcom,supply-post-on-sleep = <0x02>;
			qcom,supply-disable-load = <0x115>;
			qcom,supply-enable-load = <0x25990>;
			qcom,supply-max-voltage = <0x1b7740>;
			qcom,supply-min-voltage = <0x1b7740>;
			qcom,supply-name = "vddio";
			reg = <0x00>;
		};
		qcom,panel-supply-entry@1 {
			qcom,supply-post-on-sleep = <0x02>;
			qcom,supply-disable-load = <0x03>;
			qcom,supply-enable-load = <0x35b60>;
			qcom,supply-max-voltage = <0x1312d0>;
			qcom,supply-min-voltage = <0x1312d0>;
			qcom,supply-name = "vdd";
			reg = <0x01>;
		};
		qcom,panel-supply-entry@2 {
			qcom,supply-post-on-sleep = <0x02>;
			qcom,supply-post-off-sleep = <0x02>;
			qcom,supply-pre-off-sleep = <0x02>;
			qcom,supply-disable-load = <0x01>;
			qcom,supply-enable-load = <0x2710>;
			qcom,supply-max-voltage = <0x2dc6c0>;
			qcom,supply-min-voltage = <0x2dc6c0>;
			qcom,supply-name = "vci";
			reg = <0x02>;
		};
	};
	dsi_display_primary: qcom,dsi-display-primary {
		/* pinctrl-3 = <0x7c2 0x7c3 0x7bb 0x7bc 0x7bd 0x7be 0x7bf>;  -- TLMM pin state, see nx741j-hw.dtsi */
		/* pinctrl-2 = <0x7b9 0x7c1 0x7c0 0x7bc 0x7bd 0x7be 0x7bf>;  -- TLMM pin state, see nx741j-hw.dtsi */
		/* pinctrl-1 = <0x7b9 0x7ba 0x7c0 0x7bc 0x7bd 0x7be 0x7bf>;  -- TLMM pin state, see nx741j-hw.dtsi */
		/* pinctrl-0 = <0x7b9 0x7ba 0x7bb 0x7bc 0x7bd 0x7be 0x7bf>;  -- TLMM pin state, see nx741j-hw.dtsi */
		/* pinctrl-names = "panel_active", "panel_active_with_esync", "panel_active_with_esync_without_te", "pan...;  -- only meaningful together with pinctrl-0..3 */
		tvdd-supply = <&pmh0101_l4>;
		vdd-supply = <&pmh0101_l11>;
		vci-supply = <&pmh0101_l13>;
		vddio-supply = <&pmh0101_l12>;
		clock-names = "pll_byte_clk0", "pll_dsi_clk0", "pll_byte_clk1", "pll_dsi_clk1", "mdp_core_clk",
				"esync_clk_rcg";
		clocks = <&dsi_phy0 0x00 &dsi_phy0 0x01 &dsi_phy1 0x00 &dsi_phy1 0x01 &dispcc 0x43 &dispcc 0x01>;
		qcom,demura-panel-id = <0x122e700 0x471>;
		qcom,dsi-default-panel = <&panel>;
		qcom,mdp = <&mdss>;
		qcom,panel-te-source = <0x00>;
		qcom,platform-te-gpio = <&tlmm 0x56 0x00>;
		qcom,dsi-phy = <&dsi_phy0 &dsi_phy1>;
		qcom,dsi-ctrl = <&dsi0 &dsi1>;
		status = "ok";
		qcom,op-label = "hwio";
		label = "primary";
		compatible = "qcom,dsi-display";
	};
	dsi_display_secondary: qcom,dsi-display-secondary {
		/* pinctrl-3 = <0x7c9 0x7ca 0x7c6>;  -- TLMM pin state, see nx741j-hw.dtsi */
		/* pinctrl-2 = <0x7c4 0x7c8 0x7c7>;  -- TLMM pin state, see nx741j-hw.dtsi */
		/* pinctrl-1 = <0x7c4 0x7c5 0x7c7>;  -- TLMM pin state, see nx741j-hw.dtsi */
		/* pinctrl-0 = <0x7c4 0x7c5 0x7c6>;  -- TLMM pin state, see nx741j-hw.dtsi */
		/* pinctrl-names = "panel_active", "panel_active_with_esync", "panel_active_with_esync_without_te", "pan...;  -- only meaningful together with pinctrl-0..3 */
		tvdd-supply = <&pmh0101_l4>;
		vdd-supply = <&pmh0101_l11>;
		vci-supply = <&pmh0101_l13>;
		vddio-supply = <&pmh0101_l12>;
		clock-names = "pll_byte_clk0", "pll_dsi_clk0", "pll_byte_clk1", "pll_dsi_clk1", "mdp_core_clk",
				"esync_clk_rcg";
		clocks = <&dsi_phy0 0x00 &dsi_phy0 0x01 &dsi_phy1 0x00 &dsi_phy1 0x01 &dispcc 0x43 &dispcc 0x03>;
		qcom,demura-panel-id = <0x00 0x00>;
		qcom,mdp = <&mdss>;
		qcom,panel-te-source = <0x01>;
		qcom,platform-te-gpio = <&tlmm 0x57 0x00>;
		qcom,dsi-phy = <&dsi_phy0 &dsi_phy1>;
		qcom,dsi-ctrl = <&dsi0 &dsi1>;
		status = "ok";
		qcom,op-label = "hwio";
		label = "secondary";
		compatible = "qcom,dsi-display";
	};
	smmu_sde_unsec: qcom,smmu_sde_unsec_cb {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x43>;
		dma-coherent;
		qcom,iommu-earlymap;
		qcom,iommu-faults = "non-fatal";
		/* memory-region = <0x668>;  -- reserved-memory region, not modelled yet */
		iommus = <&apps_smmu 0x800 0x02>;
		status = "ok";
		qcom,op-label = "hwio";
		compatible = "qcom,smmu_sde_unsec";
	};
	smmu_sde_sec: qcom,smmu_sde_sec_cb {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x43>;
		qcom,iommu-vmid = <0x0a>;
		qcom,iommu-faults = "non-fatal";
		/* memory-region = <0x668>;  -- reserved-memory region, not modelled yet */
		iommus = <&apps_smmu 0x801 0x00>;
		status = "ok";
		qcom,op-label = "hwio";
		compatible = "qcom,smmu_sde_sec";
	};
	wb_display0: qcom,wb-display@0 {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x43>;
		status = "ok";
		qcom,op-label = "hwio";
		label = "wb_display0";
		cell-index = <0x00>;
		compatible = "qcom,wb-display";
	};
	wb_display1: qcom,wb-display@1 {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x43>;
		status = "ok";
		qcom,op-label = "hwio";
		label = "wb_display1";
		cell-index = <0x01>;
		compatible = "qcom,wb-display";
	};
};
