/*
 * Nubia Z80 Ultra (NX741J) MSM display controller (SDE/MDP + DSI).
 *
 * Generated by scripts/mk-mdss-dtsi.py from the device live FDT
 * (adb pull /sys/firmware/fdt); do not hand-edit, re-run the script instead.
 *
 * The stock tree keeps these nodes under /soc; they are placed at the root here
 * because sm8850.dtsi does not describe a /soc container yet.
 *
 * Providers outside the display block (GCC, DISPCC, RPMh clock, NoC, PMIC
 * regulators, qfprom cells, SMMU, SOCCP) are placeholders that carry the real
 * compatible/binding properties with status = "disabled": they exist so the
 * phandle lists keep their shape and the fragment compiles on its own.  Replace
 * them with the real driver nodes when those drivers are ported.
 *
 * Excluded on purpose: the DisplayPort connector (qcom,dp_display@9ad2000) and the
 * CESTA/HDCP block (qcom,sde_cesta@0x9bd8000) pull in the USB/alt-mode graph, so
 * their entries in mdss "connectors" are dropped; the TLMM pinctrl states of the
 * DSI connectors are dropped too (pinmux is a separate step).
 *
 * Nothing here is exported to the ADT yet: no node carries unixnu,adt-name.
 */

/ {
	/* ---- display providers (placeholders) ---- */
	/* stock: /soc/clock-controller@100000 */
	gcc: clock-controller@100000 {
		compatible = "qcom,canoe-gcc", "syscon";
		reg = <0x00 0x100000 0x00 0x1f4200>;
		reg-name = "cc_base";
		clock-names = "bi_tcxo", "pcie_0_pipe_clk", "sleep_clk", "ufs_phy_rx_symbol_0_clk",
				"ufs_phy_rx_symbol_1_clk", "ufs_phy_tx_symbol_0_clk", "usb3_phy_wrapper_gcc_usb30_pipe_clk";
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		#power-domain-cells = <0x01>;
		status = "disabled";
	};
	/* stock: /soc/clock-controller@9ba2000 */
	dispcc: clock-controller@9ba2000 {
		compatible = "qcom,canoe-dispcc", "syscon";
		reg = <0x00 0x9ba2000 0x00 0x20000>;
		reg-name = "cc_base";
		clock-names = "bi_tcxo", "bi_tcxo_ao", "sleep_clk", "iface";
		qcom,disp_crm-crmc = <0x46>;
		#clock-cells = <0x01>;
		#power-domain-cells = <0x01>;
		#reset-cells = <0x01>;
		status = "disabled";
	};
	/* stock: /soc/clock-controller@9ba2000/clock-controller@9ba4000 */
	dispcc_mx: clock-controller@9ba4000 {
		compatible = "qcom,canoe-dispcc_mx";
		clock-names = "bi_tcxo", "sleep_clk";
		#clock-cells = <0x01>;
		status = "disabled";
	};
	/* stock: /soc/rsc@18900000/drv@2/clock-controller */
	rpmh_clk: clock-controller {
		compatible = "qcom,canoe-rpmh-clk";
		#clock-cells = <0x01>;
		status = "disabled";
	};
	/* stock: /soc/interconnect@1 */
	mc_virt: interconnect@1 {
		compatible = "qcom,canoe-mc_virt";
		#interconnect-cells = <0x01>;
		qcom,bcm-voter-names = "hlos", "cam_ife_0", "cam_ife_1", "cam_ife_2", "pcie_crm_hw_0",
				"disp_crm_hw_0", "disp_crm_hw_1", "disp_crm_hw_2", "disp_crm_hw_3", "disp_crm_hw_4",
				"disp_crm_hw_5", "disp_crm_hw_6", "disp_crm_hw_7", "disp_crm_hw_8", "disp_crm_sw_0";
		qcom,bcm-voters = <0x57 0x59 0x5a 0x5b 0x58 0x5c 0x5d 0x5e 0x5f 0x60 0x61 0x62 0x63 0x64 0x65>;
		status = "disabled";
	};
	/* stock: /soc/interconnect@1600000 */
	cnoc_cfg: interconnect@1600000 {
		compatible = "qcom,canoe-cnoc_cfg";
		reg = <0x00 0x1600000 0x00 0x6200>;
		#interconnect-cells = <0x01>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <0x57>;
		status = "disabled";
	};
	/* stock: /soc/interconnect@1780000 */
	mmss_noc: interconnect@1780000 {
		compatible = "qcom,canoe-mmss_noc";
		reg = <0x00 0x1780000 0x00 0x5b800>;
		#interconnect-cells = <0x01>;
		qcom,bcm-voter-names = "hlos", "cam_ife_0", "cam_ife_1", "cam_ife_2", "disp_crm_hw_0",
				"disp_crm_hw_1", "disp_crm_hw_2", "disp_crm_hw_3", "disp_crm_hw_4", "disp_crm_hw_5",
				"disp_crm_hw_6", "disp_crm_hw_7", "disp_crm_hw_8", "disp_crm_sw_0";
		qcom,bcm-voters = <0x57 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f 0x60 0x61 0x62 0x63 0x64 0x65>;
		status = "disabled";
	};
	/* stock: /soc/interconnect@31100000 */
	gem_noc: interconnect@31100000 {
		compatible = "qcom,canoe-gem_noc";
		reg = <0x00 0x31100000 0x00 0x153080>;
		#interconnect-cells = <0x01>;
		qcom,bcm-voter-names = "hlos", "cam_ife_0", "cam_ife_1", "cam_ife_2", "pcie_crm_hw_0",
				"disp_crm_hw_0", "disp_crm_hw_1", "disp_crm_hw_2", "disp_crm_hw_3", "disp_crm_hw_4",
				"disp_crm_hw_5", "disp_crm_hw_6", "disp_crm_hw_7", "disp_crm_hw_8", "disp_crm_sw_0";
		qcom,bcm-voters = <0x57 0x59 0x5a 0x5b 0x58 0x5c 0x5d 0x5e 0x5f 0x60 0x61 0x62 0x63 0x64 0x65>;
		status = "disabled";
	};
	/* stock: /soc/apps-smmu@15000000 */
	apps_smmu: apps-smmu@15000000 {
		compatible = "qcom,qsmmu-v500";
		reg = <0x00 0x15000000 0x00 0x100000>;
		#iommu-cells = <0x02>;
		qcom,use-3-lvl-tables;
		qcom,handoff-smrs = <0x800 0x02>;
		#global-interrupts = <0x01>;
		#size-cells = <0x02>;
		#address-cells = <0x02>;
		ranges;
		dma-coherent;
		interrupts = <0x00 0x41 0x04 0x00 0x61 0x04 0x00 0x62 0x04 0x00 0x63 0x04 0x00 0x64 0x04 0x00 0x65
				0x04 0x00 0x66 0x04 0x00 0x67 0x04 0x00 0x68 0x04 0x00 0x69 0x04 0x00 0x6a 0x04 0x00 0x6b 0x04 0x00
				0x6c 0x04 0x00 0x6d 0x04 0x00 0x6e 0x04 0x00 0x6f 0x04 0x00 0x70 0x04 0x00 0x71 0x04 0x00 0x72 0x04
				0x00 0x73 0x04 0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x76 0x04 0x00 0xb5 0x04 0x00 0xb6 0x04 0x00 0xb7
				0x04 0x00 0xb8 0x04 0x00 0xb9 0x04 0x00 0xba 0x04 0x00 0xbb 0x04 0x00 0xbc 0x04 0x00 0xbd 0x04 0x00
				0xbe 0x04 0x00 0xbf 0x04 0x00 0xc0 0x04 0x00 0x13b 0x04 0x00 0x13c 0x04 0x00 0x13d 0x04 0x00 0x13e
				0x04 0x00 0x13f 0x04 0x00 0x140 0x04 0x00 0x141 0x04 0x00 0x142 0x04 0x00 0x143 0x04 0x00 0x144
				0x04 0x00 0x145 0x04 0x00 0x146 0x04 0x00 0x147 0x04 0x00 0x148 0x04 0x00 0x149 0x04 0x00 0x14a
				0x04 0x00 0x14b 0x04 0x00 0x14c 0x04 0x00 0x14d 0x04 0x00 0x14e 0x04 0x00 0x14f 0x04 0x00 0x150
				0x04 0x00 0x151 0x04 0x00 0x152 0x04 0x00 0x153 0x04 0x00 0x154 0x04 0x00 0x155 0x04 0x00 0x156
				0x04 0x00 0x157 0x04 0x00 0x158 0x04 0x00 0x159 0x04 0x00 0x18b 0x04 0x00 0x18c 0x04 0x00 0x18d
				0x04 0x00 0x18e 0x04 0x00 0x18f 0x04 0x00 0x190 0x04 0x00 0x191 0x04 0x00 0x192 0x04 0x00 0x193
				0x04 0x00 0x194 0x04 0x00 0x195 0x04 0x00 0x196 0x04 0x00 0x197 0x04 0x00 0x198 0x04 0x00 0x199
				0x04 0x00 0x1a2 0x04 0x00 0x1a3 0x04 0x00 0x19c 0x04 0x00 0x1a5 0x04 0x00 0x2c3 0x04 0x00 0x1a7
				0x04 0x00 0x1a8 0x04 0x00 0x1a9 0x04 0x00 0x2b2 0x04 0x00 0x2b3 0x04 0x00 0x2b4 0x04 0x00 0x2b5
				0x04 0x00 0x2b6 0x04 0x00 0x2b7 0x04 0x00 0x2b8 0x04 0x00 0x2b9 0x04 0x00 0x19a 0x04 0x00 0x1e8
				0x04 0x00 0x1e9 0x04 0x00 0x1ea 0x04 0x00 0x1eb 0x04 0x00 0x1ec 0x04 0x00 0x1ed 0x04 0x00 0x1ee
				0x04 0x00 0x1ef 0x04 0x00 0x1f0 0x04 0x00 0x1f1 0x04 0x00 0x1f2 0x04 0x00 0x1f3 0x04 0x00 0x1f4
				0x04 0x00 0x1f5 0x04 0x00 0x1f6 0x04>;
		qcom,actlr = <0x1800 0xc0 0x01 0x1820 0x00 0x01 0x1860 0x00 0x103 0x18a0 0x00 0x103 0x18e0 0x00 0x103
				0x1980 0x00 0x01 0x1c00 0x00 0x01 0xc01 0x40 0x303 0xc02 0x20 0x303 0xc03 0x40 0x303 0xc04 0x20
				0x303 0xc05 0x20 0x303 0xc06 0x20 0x303 0xc07 0x40 0x303 0xc08 0x20 0x303 0xc09 0x40 0x303 0xc0c
				0x40 0x303 0xc0d 0x40 0x303 0xc21 0x00 0x303 0xc23 0x00 0x303 0xc27 0x00 0x303 0xc29 0x00 0x303
				0xc2c 0x00 0x303 0xc2d 0x00 0x303 0xc42 0x00 0x303 0xc44 0x00 0x303 0xc45 0x00 0x303 0xc46 0x00
				0x303 0xc48 0x00 0x303 0x800 0x02 0x01 0x801 0x00 0x01 0x19a3 0x00 0x01 0x19a4 0x00 0x01 0x1900
				0x20 0x103 0x1904 0x20 0x103 0x1923 0x00 0x103 0x1940 0x00 0x103 0x1941 0x00 0x103 0x1943 0x00
				0x103 0x1944 0x00 0x103 0x1945 0x00 0x103 0x1946 0x00 0x103 0x1a20 0x00 0x103 0x1a21 0x00 0x103>;
		status = "disabled";
	};
	/* stock: /soc/remoteproc-soccp@a3380000 */
	soccp: remoteproc-soccp@a3380000 {
		compatible = "qcom,canoe-soccp-pas";
		reg = <0x00 0xa3380000 0x00 0x10000>;
		cx-uV-uA = <0x40 0x00>;
		mx-uV-uA = <0x40 0x00>;
		reg-names = "cx", "mx";
		clock-names = "xo";
		firmware-name = "soccp.mbn", "soccp_dtb.mbn";
		interrupt-names = "wdog", "fatal", "ready", "stop-ack", "handover", "pong", "wake-ack";
		qcom,smem-states = <0x6c 0x00 0x6c 0x0a 0x6c 0x09 0x6c 0x08>;
		qcom,smem-state-names = "stop", "wakeup", "sleep", "ping";
		status = "disabled";
	};
	/* stock: /soc/qfprom@221c8000/ssip_config@148 */
	qfprom_ssip_config: ssip_config@148 {
		bit = <0x03 0x03>;
		status = "disabled";
	};
	/* stock: /soc/qfprom@221c8000/disp_qultiv_fuse@144 */
	qfprom_disp_qultiv_fuse: disp_qultiv_fuse@144 {
		status = "disabled";
	};
	/* stock: /soc/rsc@18900000/drv@2/rpmh-regulator-mmcxlvl/regulator-pmh0110-d-s7-level */
	pmh0110_d_s7_level: regulator-pmh0110-d-s7-level {
		regulator-name = "pmh0110_d_s7_level";
		qcom,set = <0x03>;
		regulator-min-microvolt = <0x38>;
		regulator-max-microvolt = <0xffff>;
		qcom,init-voltage-level = <0x180>;
		qcom,proxy-consumer-enable;
		qcom,proxy-consumer-voltage = <0x180 0xffff>;
		status = "disabled";
	};
	/* stock: /soc/rsc@18900000/drv@2/rpmh-regulator-l1d-e0/regulator-pmh0110-d-l1 */
	pmh0110_d_l1: regulator-pmh0110-d-l1 {
		regulator-name = "pmh0110_d_l1";
		qcom,set = <0x03>;
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x132a40>;
		qcom,init-voltage = <0x124f80>;
		qcom,init-mode = <0x03>;
		qcom,proxy-consumer-enable;
		status = "disabled";
	};
	/* stock: /soc/rsc@18900000/drv@2/rpmh-regulator-l3d-e0/regulator-pmh0110-d-l3 */
	pmh0110_d_l3: regulator-pmh0110-d-l3 {
		regulator-name = "pmh0110_d_l3";
		qcom,set = <0x03>;
		regulator-min-microvolt = <0xd6d80>;
		regulator-max-microvolt = <0xd6d80>;
		qcom,init-voltage = <0xd6d80>;
		qcom,init-mode = <0x03>;
		qcom,proxy-consumer-enable;
		status = "disabled";
	};
	/* stock: /soc/rsc@18900000/drv@2/rpmh-regulator-l4b-e0/regulator-pmh0101-l4 */
	pmh0101_l4: regulator-pmh0101-l4 {
		regulator-name = "pmh0101_l4";
		qcom,set = <0x03>;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		qcom,init-voltage = <0x1b7740>;
		qcom,init-mode = <0x03>;
		status = "disabled";
	};
	/* stock: /soc/rsc@18900000/drv@2/rpmh-regulator-l11b-e0/regulator-pmh0101-l11 */
	pmh0101_l11: regulator-pmh0101-l11 {
		regulator-name = "pmh0101_l11";
		qcom,set = <0x03>;
		regulator-min-microvolt = <0xf4240>;
		regulator-max-microvolt = <0x13b6e0>;
		qcom,init-voltage = <0x1312d0>;
		qcom,init-mode = <0x03>;
		status = "disabled";
	};
	/* stock: /soc/rsc@18900000/drv@2/rpmh-regulator-l12b-e0/regulator-pmh0101-l12 */
	pmh0101_l12: regulator-pmh0101-l12 {
		regulator-name = "pmh0101_l12";
		qcom,set = <0x03>;
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x1b7740>;
		qcom,init-voltage = <0x1b7740>;
		qcom,init-mode = <0x03>;
		status = "disabled";
	};
	/* stock: /soc/rsc@18900000/drv@2/rpmh-regulator-l13b-e0/regulator-pmh0101-l13 */
	pmh0101_l13: regulator-pmh0101-l13 {
		regulator-name = "pmh0101_l13";
		qcom,set = <0x03>;
		regulator-min-microvolt = <0x2dc6c0>;
		regulator-max-microvolt = <0x2dc6c0>;
		qcom,init-voltage = <0x2dc6c0>;
		qcom,init-mode = <0x03>;
		status = "disabled";
	};

	/* ---- display controller ---- */
	mdss: qcom,mdss_mdp@9800000 {
		nvmem-cell-names = "ssip_config", "disp_qultiv_fuse";
		nvmem-cells = <&qfprom_ssip_config &qfprom_disp_qultiv_fuse>;
		qcom,sde-dspp-ltm-off = <0x3300 0x3300 0x3300 0x3300>;
		qcom,sde-dspp-ltm-version = <0x10004>;
		qcom,sde-ib-bw-vote = <0x2625a0 0x00 0xc3500>;
		qcom,sde-has-idle-pc;
		interconnect-names = "qcom,sde-data-bus0", "qcom,sde-ebi-bus", "qcom,sde-reg-bus";
		interconnects = <&mmss_noc 0x17 &gem_noc 0x22a &mc_virt 0x03 &mc_virt 0x200 &gem_noc 0x02 &cnoc_cfg
				0x207>;
		qcom,sde-soccp-controller = <&soccp>;
		qti,smmu-proxy-cb-id = <0x01>;
		qcom,sde-vm-exclude-reg-names = "ipcc_reg", "swfuse_phys";
		mmcx-supply = <&pmh0110_d_s7_level>;
		qcom,hw-fence-sw-version = <0x01>;
		clock-max-rate = <0x00 0x00 0x00 0x124f800 0x26be3680 0x26be3680>;
		clock-rate = <0x00 0x00 0x00 0x124f800 0x26be3680 0x26be3680>;
		clock-names = "gcc_bus", "iface_clk", "ahb_swi_clk", "vsync_clk", "lut_clk", "ssip_clk";
		clocks = <&gcc 0x0f &dispcc 0x06 &dispcc 0x08 &dispcc 0x52 &dispcc 0x46 &dispcc 0x47>;
		qcom,sde-reg-bus,vectors-KBps = <0x00 0x00 0x00 0x36b0 0x00 0x222e0 0x00 0x4baf0>;
		qcom,sde-secure-sid-mask = <0x2801 0x2c01>;
		qcom,sde-reg-dma-clk-ctrl = <0x2bc 0x14>;
		qcom,sde-reg-dma-xin-id = <0x07>;
		qcom,sde-reg-dma-trigger-off = <0x119c>;
		qcom,sde-reg-dma-version = <0x40000>;
		qcom,sde-reg-dma-id = <0x00 0x01>;
		qcom,sde-reg-dma-off = <0x00 0x800>;
		qcom,sde-ipcc-client-out-phys-id = <0x18>;
		qcom,sde-ipcc-protocol-offset = <0xc0000>;
		qcom,sde-hw-fence-mdp-ctl-offset = <0x4000>;
		qcom,sde-ipcc-client-dpu-phys-id = <0x15>;
		qcom,sde-ipcc-protocol-id = <0x04>;
		qcom,sde-qos-cpu-irq-latency = <0x12c>;
		qcom,sde-qos-cpu-dma-latency = <0x12c>;
		qcom,sde-qos-cpu-mask-performance = <0x03>;
		qcom,sde-qos-cpu-mask = <0x03>;
		qcom,sde-cdp-setting = <0x01 0x01 0x01 0x00>;
		qcom,sde-creq-lut = <0x112233 0x44556666 0x112233 0x66666666 0x112233 0x44556666 0x112233 0x66666666
				0x00 0x00 0x00 0x00 0x77776666 0x66666540 0x77776666 0x66666540 0x77776541 0x00 0x77776541 0x00
				0x112233 0x44556666 0x112233 0x66666666 0x112233 0x44556666 0x112233 0x66666666 0x00 0x00 0x00 0x00
				0x55555544 0x33221100 0x55555544 0x33221100>;
		qcom,sde-safe-lut = <0xff00 0xfff0 0xff00 0xfff0 0xffff 0xffff 0x01 0x01 0x3ff 0x3ff 0xff00 0xfff0
				0xff00 0xfff0 0xffff 0xffff 0xff 0xff>;
		qcom,sde-danger-lut = <0xffff 0xffff 0xffff 0xffff 0x00 0x00 0x00 0x00 0x00 0x00 0xffff 0xffff 0xffff
				0xffff 0x00 0x00 0xffff0000 0xffff0000>;
		qcom,sde-vbif-qos-wb-rot-remap = <0x04 0x04 0x05 0x05 0x05 0x05 0x05 0x06 0x04 0x04 0x05 0x05 0x05
				0x05 0x05 0x06>;
		qcom,sde-vbif-qos-cnoc-remap = <0x03 0x03 0x04 0x04 0x05 0x05 0x05 0x05 0x03 0x03 0x04 0x04 0x05 0x05
				0x05 0x05>;
		qcom,sde-vbif-qos-offline-wb-remap = <0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03
				0x03 0x03 0x03 0x03>;
		qcom,sde-vbif-qos-lutdma-remap = <0x04 0x04 0x04 0x04 0x05 0x05 0x05 0x05 0x04 0x04 0x04 0x04 0x05
				0x05 0x05 0x05>;
		qcom,sde-vbif-qos-cwb-remap = <0x04 0x04 0x05 0x05 0x05 0x05 0x05 0x06 0x04 0x04 0x05 0x05 0x05 0x05
				0x05 0x06>;
		qcom,sde-vbif-qos-nrt-remap = <0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03
				0x03 0x03>;
		qcom,sde-vbif-qos-rt-remap = <0x04 0x04 0x05 0x05 0x05 0x05 0x05 0x06 0x04 0x04 0x05 0x05 0x05 0x05
				0x05 0x06>;
		qcom,sde-vbif-dynamic-ot-wr-limit = <0x3b53800 0x02 0x76a7000 0x06 0x1da9c000 0x10>;
		qcom,sde-vbif-default-ot-wr-limit = <0x20>;
		qcom,sde-vbif-default-ot-rd-limit = <0x28>;
		qcom,sde-vbif-memtype-1 = <0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03>;
		qcom,sde-vbif-memtype-0 = <0x03 0x03 0x03 0x03 0x03 0x03 0x03 0x03>;
		qcom,sde-vbif-id = <0x00>;
		qcom,sde-vbif-size = <0x1074>;
		qcom,sde-vbif-off = <0x00>;
		qcom,sde-uidle-size = <0x80>;
		qcom,sde-uidle-off = <0x6000>;
		qcom,sde-lm-noise-version = <0x10000>;
		qcom,sde-lm-noise-off = <0x320>;
		qcom,sde-dspp-spr-dither-off = <0x34e0 0x34e0 0x34e0 0x34e0>;
		qcom,sde-dspp-spr-dither-version = <0x20000>;
		qcom,sde-dspp-spr-version = <0x20000>;
		qcom,sde-dspp-spr-size = <0x200>;
		qcom,sde-dspp-spr-off = <0x3400 0x3400 0x3400 0x3400>;
		qcom,sde-num-nrt-paths = <0x00>;
		qcom,sde-dram-channels = <0x04>;
		qcom,sde-min-dram-ib-kbps = "", "\f5";
