/*
 * NX741J hardware nodes copied from the device's own stock FDT
 * (stock/dt/live_fdt.dtb, SHA-256 a5c109c0…). These nodes are status="disabled":
 * they document the real register/IRQ/GPIO values for driver bring-up and do not
 * claim the Linux drivers are ported. Clock/regulator/SMMU phandles are omitted on
 * purpose so the fragment compiles against the minimal sm8850.dtsi.
 */

/ {
    tlmm: pinctrl@f000000 {
        compatible = "qcom,canoe-tlmm";
        reg = <0x0 0x0f000000 0x0 0x202000>;
        gpio-controller;
        #gpio-cells = <0x2>;
        interrupt-controller;
        #interrupt-cells = <0x2>;
        status = "disabled";
    };

    ufshc@1d84000 {
        compatible = "qcom,ufshc";
        reg = <0x0 0x1d84000 0x0 0x3000
               0x0 0x1d88000 0x0 0x18000
               0x0 0x1da5000 0x0 0x2000
               0x0 0x1da4000 0x0 0x10>;
        reg-names = "ufs_mem", "ice", "mcq_sqd", "mcq_vs";
        interrupts = <0x0 0x109 0x4>;
        unixnu,adt-name = "ufshc";
        status = "okay";
    };

    ufsphy_mem@1d80000 {
        reg = <0x0 0x1d80000 0x0 0x2000>;
        reg-names = "phy_mem";
        #phy-cells = <0x0>;
        status = "disabled";
    };

    pcie@1c00000 {
        compatible = "qcom,pci-msm";
        reg = <0x0 0x1c00000 0x0 0x3000
               0x0 0x1c06000 0x0 0x2000
               0x4 0x0 0x0 0x10000000
               0x4 0xf20 0x0 0xa8
               0x4 0x10000000 0x0 0x1000
               0x0 0x1d07000 0x0 0x7000>;
        reg-names = "parf", "phy", "dm_core", "elbi", "iatu", "pcie_sm";
        #address-cells = <0x3>;
        #size-cells = <0x2>;
        ranges = <0x1000000 0x0 0x40200000 0x0 0x40200000 0x0 0x100000
                  0x2000000 0x0 0x40300000 0x0 0x40300000 0x0 0x3d00000
                  0x43000000 0x4 0x10100000 0x4 0x10100000 0x2 0xeff00000>;
        interrupts = <0x0 0x8c 0x4>, <0x0 0x95 0x4>, <0x0 0x96 0x4>,
                     <0x0 0x97 0x4>, <0x0 0x98 0x4>;
        interrupt-names = "int_global_int", "int_a", "int_b", "int_c", "int_d";
        perst-gpios = <&tlmm 0x66 0x0>;
        status = "disabled";
    };

    cnss-peach@b0000000 {
        compatible = "qcom,cnss-peach";
        reg = <0x0 0xb0000000 0x0 0x10000>;
        qcom,wlan-rc-num = <0x0>;
        qcom,wlan-sw-ctrl-gpio = <&tlmm 0x13 0x0>;
        status = "disabled";
    };

    dwc3@a600000 {
        compatible = "snps,dwc3";
        reg = <0x0 0xa600000 0x0 0xd93c>;
        interrupts = <0x0 0x85 0x4>;
        status = "disabled";
    };

    gpio_keys {
        compatible = "gpio-keys";
        label = "gpio-keys";
        status = "disabled";

        vol_up {
            label = "volume_up";
            gpios = <&tlmm 0x65 0x1>;
            linux,input-type = <0x1>;
            linux,code = <0x73>;
            debounce-interval = <0xf>;
        };
        focus {
            label = "focus_key";
            gpios = <&tlmm 0xb3 0x1>;
            linux,input-type = <0x1>;
            linux,code = <0x210>;
            debounce-interval = <0xf>;
        };
        shoot {
            label = "shoot_key";
            gpios = <&tlmm 0x5f 0x1>;
            linux,input-type = <0x1>;
            linux,code = <0xd4>;
            debounce-interval = <0xf>;
        };
    };

    sound {
        compatible = "qcom,canoe-asoc-snd";
        qcom,model = "canoe-mtp-wsa884x-snd-card";
        status = "disabled";
    };

    qcom,kgsl-3d0@3d00000 {
        compatible = "qcom,adreno-gpu-gen8-2-1";
        reg = <0x0 0x3d00000 0x0 0x40000
               0x0 0x3d50000 0x0 0x10000
               0x0 0x3d61000 0x0 0x3000
               0x0 0x3d9e000 0x0 0x2000>;
        reg-names = "kgsl_3d0_reg_memory", "rscc", "cx_dbgc", "cx_misc";
        interrupts = <0x0 0x12c 0x4>, <0x0 0x50 0x4>;
        interrupt-names = "kgsl_3d0_irq", "cx_host_irq";
        qcom,gpu-model = "Adreno840v2";
        qcom,chipid = <0x44050a01>;
        status = "disabled";
    };

    spi@1a80000 {
        compatible = "qcom,spi-geni";
        reg = <0x1a80000 0x4000>;
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        interrupts = <0x0 0x358 0x4>;
        spi-max-frequency = <0x2faf080>;
        status = "disabled";

        touch@0 {
            compatible = "synaptics,tcm-spi";
            reg = <0x0>;
            spi-max-frequency = <0x989680>;
            reset-gpios = <&tlmm 0x42 0x0>;
            interrupts-extended = <&tlmm 0x9e 0x2008>;
            status = "disabled";
        };
    };
};
